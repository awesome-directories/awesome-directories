# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mautic Configuration (REQUIRED)
VITE_MAUTIC_BASE_URL=https://mautic.your-domain.com
VITE_MAUTIC_FORM_ID=your-form-id-here

# Pirsch Analytics (OPTIONAL - leave empty if not using)
VITE_PIRSCH_SITE_ID=

# GitHub Configuration for Giscus Comments (OPTIONAL)
VITE_GITHUB_REPO=awesome-directories/awesome-directories
VITE_GITHUB_REPO_ID=your-repo-id
VITE_GITHUB_CATEGORY=Announcements
VITE_GITHUB_CATEGORY_ID=your-category-id

# App Configuration
VITE_APP_NAME=Awesome Directories
VITE_APP_URL=https://awesome-directories.github.io/awesome-directories

# Preview Build Configuration (OPTIONAL - for CI/CD preview deployments)
# Set to "true" to show draft and future blog posts in preview builds
# Automatically set by CI for pull request previews
# PUBLIC_PREVIEW=true

# CI/CD and Edge Functions (OPTIONAL - for automated updates)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
APIFY_API_TOKEN=your-apify-api-token-here
FUNCTION_SECRET=your-random-secret-key-for-edge-function-auth

# Email Configuration (Resend) - Required for email notifications
RESEND_API_KEY=re_xxxxxxxxx                       # Get from Resend dashboard > API Keys
REPLY_TO_EMAIL=support@awesome-directories.com    # Reply-to address for emails
ADMIN_EMAIL=admin@awesome-directories.com         # Admin notifications recipient
SITE_URL=https://awesome-directories.com          # Site URL for email links

# Web Scraper Configuration (OPTIONAL - for directory curation)
USE_PROXY=false                          # Set to 'true' to enable Apify proxy
CHROME_PATH=                             # Custom Chrome executable path (auto-detect if empty)
LOG_LEVEL=INFO                           # Log level: DEBUG, INFO, WARN, ERROR
