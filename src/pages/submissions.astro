---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppHeader from '@/components/AppHeader.astro';
import AppFooter from '@/components/AppFooter.astro';
import SubmissionsPage from '@/components/SubmissionsPage.vue';
import "@/style.css";

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'My Submissions - Awesome Directories',
    description: 'Track your directory submission status.',
    url: 'https://awesome-directories.com/submissions',
  },
];
---

<BaseLayout
  title="My Submissions - Awesome Directories"
  description="Track the status of your directory submissions and manage pending reviews."
  structuredData={structuredData}
>
  <AppHeader />

  <SubmissionsPage client:only="vue" />

  <AppFooter />
</BaseLayout>
