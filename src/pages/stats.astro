---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import StatsCards from "@/components/StatsCards.vue";
import StatsCharts from "@/components/StatsCharts.vue";
import TopDirectoriesTable from "@/components/TopDirectoriesTable.vue";
---

<BaseLayout
  title="Statistics | Awesome Directories"
  description="Explore comprehensive statistics and analytics for 388+ curated launch directories. View category distributions, Domain Rating trends, and top-performing directories."
>
  <AppHeader />

  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          Directory Statistics
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Comprehensive analytics and insights from our curated collection of
          launch directories. All data is updated during each build.
        </p>
      </div>

      <!-- Overview Cards -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Overview</h2>
        <StatsCards client:load />
      </div>

      <!-- Charts Section -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Analytics</h2>
        <StatsCharts client:load />
      </div>

      <!-- Top Directories Tables -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Top Directories</h2>
        <TopDirectoriesTable client:load />
      </div>

      <!-- Additional Info -->
      <div class="card p-8 bg-blue-50 border-blue-200">
        <h2 class="text-xl font-bold text-gray-900 mb-3">
          About These Statistics
        </h2>
        <p class="text-gray-700 mb-4">
          These statistics are calculated at build time from our verified
          directory database. All metrics include only active, verified
          directories to ensure data quality.
        </p>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
          <li>
            <strong>Domain Rating (DR):</strong> Authority score from 0-100, higher
            is better
          </li>
          <li>
            <strong>Helpful Votes:</strong> Community votes indicating directory
            quality and effectiveness
          </li>
          <li>
            <strong>Link Types:</strong> Dofollow links pass SEO value, nofollow
            links don't
          </li>
          <li>
            <strong>Categories:</strong> Directories can belong to multiple categories
          </li>
        </ul>
      </div>
    </div>
  </main>

  <AppFooter />
</BaseLayout>

<script>
  // Track page view with Pirsch
  if (typeof window !== "undefined" && typeof window.pirsch === "function") {
    window.pirsch("Stats Page View");
  }
</script>
