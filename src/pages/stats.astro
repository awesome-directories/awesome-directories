---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import StatsCards from "@/components/StatsCards.vue";
import StatsCharts from "@/components/StatsCharts.vue";
import TopDirectoriesTable from "@/components/TopDirectoriesTable.vue";
---

<BaseLayout
  title="Statistics | Awesome Directories"
  description="Explore comprehensive statistics and analytics for 300+ curated launch directories. View category distributions, Domain Rating trends, and top-performing directories."
>
  <AppHeader />

  <main class="stats-main">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="text-center mb-8 sm:mb-12">
        <h1 class="stats-title">
          Directory Statistics
        </h1>
        <p class="stats-subtitle">
          Comprehensive analytics and insights from our curated collection of
          launch directories. All data is updated during each build.
        </p>
      </div>

      <!-- Overview Cards -->
      <div class="mb-8 sm:mb-12">
        <h2 class="section-heading">
          Overview
        </h2>
        <StatsCards client:load />
      </div>

      <!-- Charts Section -->
      <div class="mb-8 sm:mb-12">
        <h2 class="section-heading">
          Analytics
        </h2>
        <StatsCharts client:load />
      </div>

      <!-- Top Directories Tables -->
      <div class="mb-8 sm:mb-12">
        <h2 class="section-heading">
          Top Directories
        </h2>
        <TopDirectoriesTable client:load />
      </div>

      <!-- Additional Info -->
      <div class="info-card">
        <h2 class="info-card-title">
          About These Statistics
        </h2>
        <p class="info-card-text">
          These statistics are calculated at build time from our verified
          directory database. All metrics include only active, verified
          directories to ensure data quality.
        </p>
        <ul class="info-card-list">
          <li>
            <strong>Domain Rating (DR):</strong> Authority score from 0-100, higher
            is better
          </li>
          <li>
            <strong>Helpful Votes:</strong> Community votes indicating directory
            quality and effectiveness
          </li>
          <li>
            <strong>Link Types:</strong> Dofollow links pass SEO value, nofollow
            links don't
          </li>
          <li>
            <strong>Categories:</strong> Directories can belong to multiple categories
          </li>
        </ul>
      </div>
    </div>
  </main>

  <AppFooter />
</BaseLayout>

<style>
  .stats-main {
    min-height: 100vh;
    background-color: var(--color-bg-secondary);
    padding: 2rem 0;
  }

  @media (min-width: 640px) {
    .stats-main {
      padding: 3rem 0;
    }
  }

  .stats-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .stats-title {
      font-size: 1.875rem;
      margin-bottom: 1rem;
    }
  }

  @media (min-width: 768px) {
    .stats-title {
      font-size: 2.25rem;
    }
  }

  .stats-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 0.5rem;
  }

  @media (min-width: 640px) {
    .stats-subtitle {
      font-size: 1rem;
    }
  }

  @media (min-width: 768px) {
    .stats-subtitle {
      font-size: 1.125rem;
    }
  }

  .section-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .section-heading {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }

  .info-card {
    background-color: var(--color-info-bg);
    border: 1px solid var(--color-info);
    border-radius: var(--radius-xl);
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .info-card {
      padding: 1.5rem;
      border-radius: var(--radius-lg);
    }
  }

  @media (min-width: 768px) {
    .info-card {
      padding: 2rem;
    }
  }

  .info-card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .info-card-title {
      font-size: 1.25rem;
    }
  }

  .info-card-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .info-card-text {
      font-size: 1rem;
    }
  }

  .info-card-list {
    list-style-type: disc;
    list-style-position: inside;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .info-card-list {
      font-size: 1rem;
    }
  }

  .info-card-list strong {
    color: var(--color-text-primary);
  }
</style>
