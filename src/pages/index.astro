---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import DirectoryListContent from "@/components/DirectoryListContent.vue";
import {
  getAllDirectories,
  getUniqueCategories,
} from "@/lib/data/directories.js";
import log from "@/lib/logger.js";
import "@/style.css";

var allDirectories = await getAllDirectories();
var categories = getUniqueCategories(allDirectories);

log.info(`Total directories fetched: ${allDirectories.length}`);

var totalCount = allDirectories.length;
var drCount = allDirectories.filter(function countDR(d) {
  return d.domain_rating;
}).length;

// Get featured directories (top DoFollow directories by DR)
var featuredDirectories = allDirectories
  .filter(function filterFeatured(d) {
    return d.domain_rating && d.is_dofollow;
  })
  .sort(function sortByDR(a, b) {
    return (b.domain_rating || 0) - (a.domain_rating || 0);
  })
  .slice(0, 6);

var structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description:
      "Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers.",
    inLanguage: "en-US",
    publisher: {
      "@type": "Organization",
      name: "Awesome Directories",
      url: "https://awesome-directories.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://awesome-directories.com/logo.png",
        width: 512,
        height: 512,
      },
    },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "https://awesome-directories.com/?q={search_term_string}",
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description: "Curated launch directories for SaaS products",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.8",
      ratingCount: "250",
      bestRating: "5",
      worstRating: "1",
    },
  },
];
---

<BaseLayout
  title="Awesome Directories - Curated Launch Directories for SaaS Founders"
  description="Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers."
  structuredData={structuredData}
>
  <AppHeader />

  <main class="min-h-screen bg-gray-50">
    <!-- Compact Hero Section -->
    <section
      class="bg-gradient-to-br from-primary to-blue-600 text-white py-8 sm:py-10 px-4"
    >
      <div class="max-w-8xl mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1
            class="text-2xl sm:text-3xl md:text-4xl font-bold mb-2 sm:mb-3 px-2"
          >
            Hand-picked Launch Directories with Real DR Scores
          </h1>
          <p
            class="text-base sm:text-lg text-blue-50 px-2 mb-4"
          >
            {totalCount}+ curated directories · {drCount}+ verified DR scores · Updated weekly
          </p>
        </div>

        <div class="max-w-2xl mx-auto px-2">
          <label for="search-input" class="sr-only">Search directories</label>
          <div class="relative">
            <input
              id="search-input"
              type="search"
              placeholder="Search by name or category..."
              class="w-full px-4 sm:px-6 py-3 pr-12 sm:pr-14 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-4 focus:ring-blue-300 text-base"
              aria-label="Search directories"
              autocomplete="off"
            />
            <svg
              class="absolute right-3 sm:right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <button
              id="clear-search"
              class="hidden absolute right-11 sm:right-12 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-300 rounded p-1"
              aria-label="Clear search"
            >
              <svg
                class="w-4 h-4 sm:w-5 sm:h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Directory Listing (Instant Value) -->
    <div id="directory-list">
      <DirectoryListContent client:load categories={categories} />
    </div>

    <!-- Why Awesome Directories Section (After browsing directories) -->
    <section class="bg-white py-12 sm:py-16 px-4 border-t border-gray-200">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">
            Why Awesome Directories?
          </h2>
          <p class="text-gray-600 text-lg max-w-3xl mx-auto">
            Stop wasting hours researching directories. We've done the work for you—curated, verified, and ready to launch.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <!-- Feature 1 -->
          <div class="text-center">
            <div class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">✓</span>
            </div>
            <h3 class="font-bold text-lg text-gray-900 mb-2">
              Verified DR Scores
            </h3>
            <p class="text-gray-600 text-sm">
              Real Ahrefs domain ratings updated weekly. No guessing, no dead links—just quality directories.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="text-center">
            <div class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">🚀</span>
            </div>
            <h3 class="font-bold text-lg text-gray-900 mb-2">
              Smart Filtering
            </h3>
            <p class="text-gray-600 text-sm">
              One-tap presets like "Quick Wins" or "Premium" get you the best directories instantly. No analysis paralysis.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="text-center">
            <div class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">📊</span>
            </div>
            <h3 class="font-bold text-lg text-gray-900 mb-2">
              Track Submissions
            </h3>
            <p class="text-gray-600 text-sm">
              Mark directories as submitted per project. Never double-submit or lose track of your launch progress.
            </p>
          </div>
        </div>

        <!-- Featured Directories -->
        <div class="border-t border-gray-200 pt-12">
          <div class="text-center mb-8">
            <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
              Top DoFollow Directories by DR
            </h3>
            <p class="text-gray-600">
              Start here—these are the directories that drive real traffic.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {featuredDirectories.map(function renderFeatured(directory) {
              return (
                <a
                  href={`/directory/${directory.slug}`}
                  class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors border border-gray-200"
                >
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-gray-900 truncate">
                      {directory.name}
                    </h4>
                    <p class="text-sm text-gray-500 truncate">
                      {directory.categories?.[0] || "Directory"}
                    </p>
                  </div>
                  <div class="flex items-center gap-2 ml-4">
                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                      DoFollow
                    </span>
                    <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-blue-100 text-blue-800">
                      DR {directory.domain_rating}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </main>

  <AppFooter />
</BaseLayout>
