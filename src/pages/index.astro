---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import DirectoryListContent from "@/components/DirectoryListContent.vue";
import {
  getAllDirectories,
  getUniqueCategories,
} from "@/lib/data/directories.js";
import log from "@/lib/logger.js";
import "@/style.css";

var allDirectories = await getAllDirectories();
var categories = getUniqueCategories(allDirectories);

log.info(`Total directories fetched: ${allDirectories.length}`);

var totalCount = allDirectories.length;
var drCount = allDirectories.filter(function countDR(d) {
  return d.domain_rating;
}).length;

// Get featured directories (top DoFollow directories by DR)
var featuredDirectories = allDirectories
  .filter(function filterFeatured(d) {
    return d.domain_rating && d.is_dofollow;
  })
  .sort(function sortByDR(a, b) {
    return (b.domain_rating || 0) - (a.domain_rating || 0);
  })
  .slice(0, 6);

var structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description:
      "Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers.",
    inLanguage: "en-US",
    publisher: {
      "@type": "Organization",
      name: "Awesome Directories",
      url: "https://awesome-directories.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://awesome-directories.com/logo.png",
        width: 512,
        height: 512,
      },
    },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "https://awesome-directories.com/?q={search_term_string}",
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description: "Curated launch directories for SaaS products",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.8",
      ratingCount: "250",
      bestRating: "5",
      worstRating: "1",
    },
  },
];
---

<BaseLayout
  title="Awesome Directories - Curated Launch Directories for SaaS Founders"
  description="Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers."
  structuredData={structuredData}
>
  <!-- Skip to main content link for accessibility -->
  <a
    href="#directory-list"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-white focus:rounded-lg focus:shadow-lg"
  >
    Skip to directory list
  </a>

  <AppHeader />

  <main class="min-h-screen bg-gray-50">
    <!-- Compact Hero Section -->
    <section
      class="bg-gradient-to-br from-primary to-blue-600 text-white py-8 sm:py-10 md:py-12 lg:py-16 px-4"
    >
      <div class="max-w-8xl mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1
            class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold mb-3 sm:mb-4 md:mb-6 px-2 leading-tight"
          >
            Hand-picked Launch Directories with Real DR Scores
          </h1>
          <p
            class="text-base sm:text-lg md:text-xl lg:text-2xl text-blue-50 px-2 max-w-3xl mx-auto"
          >
            {totalCount}+ curated directories · {drCount}+ verified DR scores ·
            Updated weekly
          </p>
          <div
            class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center items-center px-2"
          >
            <a
              href="#directory-list"
              class="btn-primary bg-white text-primary hover:bg-gray-100 min-h-[48px] sm:min-h-[44px] px-6 sm:px-8 w-full sm:w-auto inline-flex items-center justify-center font-semibold rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
            >
              Browse Directories
            </a>
            <a
              href="/stats"
              class="border-2 border-white text-white hover:bg-white hover:text-primary min-h-[48px] sm:min-h-[44px] px-6 sm:px-8 w-full sm:w-auto inline-flex items-center justify-center font-semibold rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
            >
              View Statistics
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Directory Listing (Instant Value) -->
    <div id="directory-list">
      <DirectoryListContent client:load categories={categories} />
    </div>

    <!-- Why Awesome Directories Section (After browsing directories) -->
    <section
      class="bg-white py-12 sm:py-16 lg:py-20 px-4 border-t border-gray-200"
    >
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-3 sm:mb-4"
          >
            Why Awesome Directories?
          </h2>
          <p
            class="text-gray-600 text-base sm:text-lg lg:text-xl max-w-3xl mx-auto"
          >
            Stop wasting hours researching directories. We've done the work for
            you—curated, verified, and ready to launch.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-12 mb-12">
          <!-- Feature 1 -->
          <div
            class="text-center p-6 rounded-lg hover:bg-gray-50 transition-colors"
          >
            <div
              class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl" aria-hidden="true">✓</span>
            </div>
            <h3 class="font-bold text-lg lg:text-xl text-gray-900 mb-2">
              Verified DR Scores
            </h3>
            <p class="text-gray-600 text-sm lg:text-base">
              Real Ahrefs domain ratings updated weekly. No guessing, no dead
              links—just quality directories.
            </p>
          </div>

          <!-- Feature 2 -->
          <div
            class="text-center p-6 rounded-lg hover:bg-gray-50 transition-colors"
          >
            <div
              class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl" aria-hidden="true">🚀</span>
            </div>
            <h3 class="font-bold text-lg lg:text-xl text-gray-900 mb-2">
              Smart Filtering
            </h3>
            <p class="text-gray-600 text-sm lg:text-base">
              One-tap presets like "Quick Wins" or "Premium" get you the best
              directories instantly. No analysis paralysis.
            </p>
          </div>

          <!-- Feature 3 -->
          <div
            class="text-center p-6 rounded-lg hover:bg-gray-50 transition-colors"
          >
            <div
              class="w-16 h-16 bg-primary bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-3xl" aria-hidden="true">📊</span>
            </div>
            <h3 class="font-bold text-lg lg:text-xl text-gray-900 mb-2">
              Track Submissions
            </h3>
            <p class="text-gray-600 text-sm lg:text-base">
              Mark directories as submitted per project. Never double-submit or
              lose track of your launch progress.
            </p>
          </div>
        </div>

        <!-- Featured Directories -->
        <div class="border-t border-gray-200 pt-12">
          <div class="text-center mb-8">
            <h3
              class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-900 mb-2"
            >
              Top DoFollow Directories by DR
            </h3>
            <p class="text-gray-600 text-sm sm:text-base">
              Start here—these are the directories that drive real traffic.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {
              featuredDirectories.map(function renderFeatured(directory) {
                return (
                  <a
                    href={`/directory/${directory.slug}`}
                    class="flex items-center justify-between p-4 sm:p-5 bg-gray-50 rounded-lg hover:bg-gray-100 hover:shadow-md transition-all border border-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                  >
                    <div class="flex-1 min-w-0">
                      <h4 class="font-semibold text-gray-900 truncate text-base sm:text-lg">
                        {directory.name}
                      </h4>
                      <p class="text-sm text-gray-500 truncate">
                        {directory.categories?.[0] || "Directory"}
                      </p>
                    </div>
                    <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                      <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                        DoFollow
                      </span>
                      <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-blue-100 text-blue-800">
                        DR {directory.domain_rating}
                      </span>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <AppFooter />
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .focus\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: 0;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
