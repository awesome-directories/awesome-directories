---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import DirectoryListContent from "@/components/DirectoryListContent.vue";
import {
  getAllDirectories,
  getUniqueCategories,
} from "@/lib/data/directories.js";
import log from "@/lib/logger.js";
import "@/style.css";

var allDirectories = await getAllDirectories();
var categories = getUniqueCategories(allDirectories);

log.info(`Total directories fetched: ${allDirectories.length}`);

var totalCount = allDirectories.length;
var drCount = allDirectories.filter(function countDR(d) {
  return d.domain_rating;
}).length;

// Get featured directories (top DoFollow directories by DR)
var featuredDirectories = allDirectories
  .filter(function filterFeatured(d) {
    return d.domain_rating && d.is_dofollow;
  })
  .sort(function sortByDR(a, b) {
    return (b.domain_rating || 0) - (a.domain_rating || 0);
  })
  .slice(0, 6);

var structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description:
      "Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers.",
    inLanguage: "en-US",
    publisher: {
      "@type": "Organization",
      name: "Awesome Directories",
      url: "https://awesome-directories.com/",
      logo: {
        "@type": "ImageObject",
        url: "https://awesome-directories.com/logo.png",
        width: 512,
        height: 512,
      },
    },
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: "https://awesome-directories.com/?q={search_term_string}",
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Awesome Directories",
    url: "https://awesome-directories.com/",
    description: "Curated launch directories for SaaS products",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Any",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.8",
      ratingCount: "250",
      bestRating: "5",
      worstRating: "1",
    },
  },
];
---

<BaseLayout
  title="Awesome Directories - Curated Launch Directories for SaaS Founders"
  description="Hand-picked launch directories with real DR scores. Filter DoFollow + High DR in seconds, export to CSV, and track submissions per project. Built by indie hackers, for indie hackers."
  structuredData={structuredData}
>
  <!-- Skip to main content link for accessibility -->
  <a
    href="#directory-list"
    class="skip-link"
  >
    Skip to directory list
  </a>

  <AppHeader />

  <main class="main-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="max-w-8xl mx-auto">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="hero-title">
            Hand-picked Launch Directories with Real DR Scores
          </h1>
          <p class="hero-subtitle">
            {totalCount}+ curated directories · {drCount}+ verified DR scores ·
            Updated weekly
          </p>
          <div class="hero-actions">
            <a
              href="#directory-list"
              class="hero-btn-primary"
            >
              Browse Directories
            </a>
            <a
              href="/stats"
              class="hero-btn-secondary"
            >
              View Statistics
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Directory Listing (Instant Value) -->
    <div id="directory-list">
      <DirectoryListContent client:load categories={categories} />
    </div>

    <!-- Why Awesome Directories Section -->
    <section class="why-section">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title">
            Why Awesome Directories?
          </h2>
          <p class="section-subtitle">
            Stop wasting hours researching directories. We've done the work for
            you—curated, verified, and ready to launch.
          </p>
        </div>

        <div class="features-grid">
          <!-- Feature 1 -->
          <div class="feature-card">
            <div class="feature-icon">
              <span aria-hidden="true">✓</span>
            </div>
            <h3 class="feature-title">
              Verified DR Scores
            </h3>
            <p class="feature-description">
              Real Ahrefs domain ratings updated weekly. No guessing, no dead
              links—just quality directories.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="feature-card">
            <div class="feature-icon">
              <span aria-hidden="true">🚀</span>
            </div>
            <h3 class="feature-title">
              Smart Filtering
            </h3>
            <p class="feature-description">
              One-tap presets like "Quick Wins" or "Premium" get you the best
              directories instantly. No analysis paralysis.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="feature-card">
            <div class="feature-icon">
              <span aria-hidden="true">📊</span>
            </div>
            <h3 class="feature-title">
              Track Submissions
            </h3>
            <p class="feature-description">
              Mark directories as submitted per project. Never double-submit or
              lose track of your launch progress.
            </p>
          </div>
        </div>

        <!-- Featured Directories -->
        <div class="featured-section">
          <div class="text-center mb-8">
            <h3 class="featured-title">
              Top DoFollow Directories by DR
            </h3>
            <p class="featured-subtitle">
              Start here—these are the directories that drive real traffic.
            </p>
          </div>

          <div class="featured-grid">
            {
              featuredDirectories.map(function renderFeatured(directory) {
                return (
                  <a
                    href={`/directory/${directory.slug}`}
                    class="featured-card"
                  >
                    <div class="flex-1 min-w-0">
                      <h4 class="featured-card-title">
                        {directory.name}
                      </h4>
                      <p class="featured-card-category">
                        {directory.categories?.[0] || "Directory"}
                      </p>
                    </div>
                    <div class="flex items-center gap-2 ml-4 flex-shrink-0">
                      <span class="badge-dofollow">
                        DoFollow
                      </span>
                      <span class="badge-dr">
                        DR {directory.domain_rating}
                      </span>
                    </div>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <AppFooter />
</BaseLayout>

<style>
  /* Skip Link */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .skip-link:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 9999;
    width: auto;
    height: auto;
    padding: 0.5rem 1rem;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    background-color: var(--color-brand-primary);
    color: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Main Content */
  .main-content {
    min-height: 100vh;
    background-color: var(--color-bg-secondary);
  }

  /* Hero Section */
  .hero-section {
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, var(--color-brand-secondary) 100%);
    color: white;
    padding: 2rem 1rem;
  }

  @media (min-width: 640px) {
    .hero-section {
      padding: 2.5rem 1rem;
    }
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 3rem 1rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding: 4rem 1rem;
    }
  }

  .hero-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    padding: 0 0.5rem;
    line-height: 1.25;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 1.875rem;
      margin-bottom: 1rem;
    }
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 2.25rem;
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 1280px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    padding: 0 0.5rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .hero-subtitle {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-subtitle {
      font-size: 1.5rem;
    }
  }

  .hero-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    padding: 0 0.5rem;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      gap: 1rem;
      margin-top: 2rem;
    }
  }

  .hero-btn-primary {
    background-color: white;
    color: var(--color-brand-primary);
    min-height: 48px;
    padding: 0 1.5rem;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-fast) var(--ease-default);
  }

  @media (min-width: 640px) {
    .hero-btn-primary {
      min-height: 44px;
      padding: 0 2rem;
      width: auto;
    }
  }

  .hero-btn-primary:hover {
    background-color: rgba(255, 255, 255, 0.9);
  }

  .hero-btn-primary:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  .hero-btn-secondary {
    border: 2px solid white;
    color: white;
    min-height: 48px;
    padding: 0 1.5rem;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-fast) var(--ease-default),
                color var(--duration-fast) var(--ease-default);
  }

  @media (min-width: 640px) {
    .hero-btn-secondary {
      min-height: 44px;
      padding: 0 2rem;
      width: auto;
    }
  }

  .hero-btn-secondary:hover {
    background-color: white;
    color: var(--color-brand-primary);
  }

  .hero-btn-secondary:focus-visible {
    outline: 2px solid white;
    outline-offset: 2px;
  }

  /* Why Section */
  .why-section {
    background-color: var(--color-bg-primary);
    padding: 3rem 1rem;
    border-top: 1px solid var(--color-border-primary);
  }

  @media (min-width: 640px) {
    .why-section {
      padding: 4rem 1rem;
    }
  }

  @media (min-width: 1024px) {
    .why-section {
      padding: 5rem 1rem;
    }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  @media (min-width: 640px) {
    .section-title {
      font-size: 1.875rem;
      margin-bottom: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .section-title {
      font-size: 2.25rem;
    }
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .section-subtitle {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1024px) {
    .section-subtitle {
      font-size: 1.25rem;
    }
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .feature-card {
    text-align: center;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-fast) var(--ease-default);
  }

  .feature-card:hover {
    background-color: var(--color-bg-tertiary);
  }

  .feature-icon {
    width: 4rem;
    height: 4rem;
    background-color: var(--color-brand-primary);
    opacity: 0.1;
    background: linear-gradient(135deg, var(--color-brand-primary) 0%, var(--color-brand-secondary) 100%);
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }

  .feature-icon span {
    font-size: 1.875rem;
  }

  .feature-title {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 1024px) {
    .feature-title {
      font-size: 1.25rem;
    }
  }

  .feature-description {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  @media (min-width: 1024px) {
    .feature-description {
      font-size: 1rem;
    }
  }

  /* Featured Section */
  .featured-section {
    border-top: 1px solid var(--color-border-primary);
    padding-top: 3rem;
  }

  .featured-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  @media (min-width: 640px) {
    .featured-title {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .featured-title {
      font-size: 1.875rem;
    }
  }

  .featured-subtitle {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .featured-subtitle {
      font-size: 1rem;
    }
  }

  /* Featured Grid */
  .featured-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-primary);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-default),
                box-shadow var(--duration-fast) var(--ease-default);
  }

  @media (min-width: 640px) {
    .featured-card {
      padding: 1.25rem;
    }
  }

  .featured-card:hover {
    background-color: var(--color-bg-tertiary);
    box-shadow: var(--shadow-md);
  }

  .featured-card:focus-visible {
    outline: var(--ring-width) solid var(--ring-color);
    outline-offset: var(--ring-offset);
  }

  .featured-card-title {
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .featured-card-title {
      font-size: 1.125rem;
    }
  }

  .featured-card-category {
    font-size: 0.875rem;
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .badge-dofollow {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    font-weight: 500;
    background-color: var(--color-success-bg);
    color: var(--color-success-text);
  }

  .badge-dr {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-md);
    font-size: 0.75rem;
    font-weight: 700;
    background-color: var(--color-info-bg);
    color: var(--color-info-text);
  }
</style>
