---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getPublishedPosts, getPostsByTag, getAllTags } from "@/utils/blog";

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getPublishedPosts();
  const allTags = getAllTags(allPosts);
  const pageSize = 10;

  // Generate paginated paths for each tag
  const paths = allTags.flatMap((tag) => {
    const tagPosts = getPostsByTag(allPosts, tag);
    return paginate(tagPosts, {
      params: { tag: tag.toLowerCase() },
      pageSize,
      props: { tag },
    });
  });

  return paths;
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { tag } = Astro.params;
const allPosts = await getPublishedPosts();
const allTags = getAllTags(allPosts);
const currentPage = page.currentPage || 1;
---

<BaseLayout
  title={`${tag} - Page ${currentPage} | Awesome Directories Blog`}
  description={`Browse all blog posts tagged with ${tag}. Find insights, guides, and tips for indie hackers and solopreneurs.`}
>
  <AppHeader />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-12">
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-gray-600">
          <li>
            <a href="/" class="hover:text-blue-600">Home</a>
          </li>
          <li>
            <span class="mx-2">/</span>
          </li>
          <li>
            <a href="/blog" class="hover:text-blue-600">Blog</a>
          </li>
          <li>
            <span class="mx-2">/</span>
          </li>
          <li class="text-gray-900 font-medium" aria-current="page">
            #{tag}
          </li>
        </ol>
      </nav>

      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Posts tagged: <span class="text-blue-600">#{tag}</span>
      </h1>
      <p class="text-xl text-gray-600">
        Page {currentPage} of {page.lastPage}
      </p>
    </div>

    <!-- All Tags -->
    {
      allTags.length > 1 && (
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Other tags:</h2>
          <div class="flex flex-wrap gap-2">
            {allTags
              .filter((t) => t.toLowerCase() !== tag?.toLowerCase())
              .map((otherTag) => (
                <a
                  href={`/blog/tags/${otherTag.toLowerCase()}`}
                  class="inline-block px-4 py-2 bg-white border border-gray-300 rounded-full hover:border-blue-600 hover:text-blue-600 transition-colors"
                >
                  #{otherTag}
                </a>
              ))}
          </div>
        </div>
      )
    }

    <!-- Blog Posts Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {page.data.map((post) => <BlogCard post={post} />)}
    </div>

    <!-- Pagination -->
    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      basePath={`/blog/tags/${tag?.toLowerCase()}`}
      hasPrev={page.currentPage > 1}
      hasNext={page.currentPage < page.lastPage}
    />
  </main>

  <AppFooter />
</BaseLayout>
