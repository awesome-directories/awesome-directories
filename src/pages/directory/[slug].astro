---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooter from "@/components/AppFooter.astro";
import DirectoryDetailActions from "@/components/DirectoryDetailActions.vue";
import { getAllDirectories } from "@/lib/data/directories.js";
import log from "@/lib/logger.js";
import "@/style.css";

// Generate static paths for all directories at build time
export async function getStaticPaths() {
  const directories = await getAllDirectories();

  log.info(`Generating ${directories.length} directory detail pages...`);

  return directories.map((directory) => ({
    params: { slug: directory.slug },
    props: { directory, allDirectories: directories },
  }));
}

const { directory, allDirectories } = Astro.props;

// Find related directories (same category, exclude current)
const relatedDirectories = allDirectories
  .filter((d) => {
    if (d.slug === directory.slug) return false;
    if (!directory.categories || !d.categories) return false;
    return directory.categories.some((cat) => d.categories.includes(cat));
  })
  .slice(0, 6);

// Helper functions for badges and labels
function getDrBadgeClass(dr) {
  if (!dr) return "bg-gray-100 text-gray-700";
  if (dr >= 80) return "bg-green-100 text-green-800";
  if (dr >= 70) return "bg-blue-100 text-blue-800";
  if (dr >= 60) return "bg-orange-100 text-orange-800";
  return "bg-gray-100 text-gray-700";
}

function getPricingBadgeClass(pricing) {
  if (pricing === "free") return "bg-green-100 text-green-800";
  if (pricing === "paid") return "bg-orange-100 text-orange-800";
  if (pricing === "freemium") return "bg-blue-100 text-blue-800";
  return "bg-gray-100 text-gray-700";
}

function getPricingLabel(directory) {
  const pricing = directory.pricing_type;
  if (pricing === "free") return "Free";
  if (pricing === "paid" && directory.pricing_amount) {
    return `$${directory.pricing_amount}`;
  }
  if (pricing === "paid") return "Paid";
  if (pricing === "freemium") return "Freemium";
  return "N/A";
}

function getTrafficLabel(estimate) {
  if (estimate === "high") return "High";
  if (estimate === "medium") return "Medium";
  if (estimate === "low") return "Low";
  return null;
}

function getTrafficBadgeClass(estimate) {
  if (estimate === "high") return "bg-green-100 text-green-800";
  if (estimate === "medium") return "bg-yellow-100 text-yellow-800";
  if (estimate === "low") return "bg-gray-100 text-gray-700";
  return "bg-gray-100 text-gray-700";
}

function getTrustScore(spamScore) {
  if (spamScore === null || spamScore === undefined) return null;
  return 100 - spamScore;
}

function formatNumber(num) {
  if (!num) return null;
  if (num >= 1000000) return `${(num / 1000000).toFixed(1)}M`;
  if (num >= 1000) return `${(num / 1000).toFixed(1)}K`;
  return num.toLocaleString();
}

// SEO metadata
const title = `${directory.name} - Submit Your Product | Awesome Directories`;
const description =
  directory.description ||
  `Submit your SaaS product to ${directory.name}. Find submission guidelines, pricing, and domain authority information.`;
const canonicalUrl = `https://awesome-directories.com/directory/${directory.slug}`;
const ogImage =
  directory.logo_url || "https://awesome-directories.com/og-image.jpg";

// Structured Data - Product Schema with AggregateRating (using actual ratings)
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: directory.name,
    description:
      directory.description || `Submit your product to ${directory.name}`,
    url: canonicalUrl,
    image: directory.logo_url || "https://awesome-directories.com/logo.png",
    brand: {
      "@type": "Organization",
      name: directory.name,
    },
    offers: {
      "@type": "Offer",
      ...(directory.pricing_type === "free"
        ? { price: "0", priceCurrency: "USD" }
        : directory.pricing_type === "paid" && directory.pricing_amount
          ? { price: directory.pricing_amount, priceCurrency: "USD" }
          : { priceCurrency: "USD" }),
      availability: "https://schema.org/InStock",
      url: directory.submission_url || canonicalUrl,
    },
    aggregateRating:
      directory.rating_count > 0
        ? {
            "@type": "AggregateRating",
            ratingValue: directory.average_rating || 0,
            ratingCount: directory.rating_count,
            bestRating: "5",
            worstRating: "1",
          }
        : undefined,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://awesome-directories.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Directories",
        item: "https://awesome-directories.com/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: directory.name,
        item: canonicalUrl,
      },
    ],
  },
];

// Check if we have any SEO metrics to display
const hasSeoMetrics =
  directory.domain_rating ||
  directory.organic_search_traffic ||
  directory.ranking_keywords ||
  directory.backlinks_count ||
  directory.referring_domains;

// Check if we have submission info
const hasSubmissionInfo =
  directory.avg_approval_days ||
  directory.submission_url ||
  directory.pricing_type;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogType="product"
  structuredData={structuredData}
  keywords={`${directory.name}, directory submission, product launch, SaaS directory, ${directory.categories?.join(", ") || ""}`}
>
  <AppHeader />

  <main class="min-h-screen bg-gray-50">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
        <ol
          class="flex items-center space-x-2 text-sm"
          itemscope
          itemtype="https://schema.org/BreadcrumbList"
        >
          <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <a
              href="/"
              class="text-primary hover:text-primary-dark transition-colors"
              itemprop="item"
            >
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <a
              href="/"
              class="text-primary hover:text-primary-dark transition-colors"
              itemprop="item"
            >
              <span itemprop="name">Directories</span>
            </a>
            <meta itemprop="position" content="2" />
          </li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <span
              class="text-gray-700 font-medium"
              itemprop="name"
              aria-current="page">{directory.name}</span
            >
            <meta itemprop="position" content="3" />
          </li>
        </ol>
      </div>
    </nav>

    <!-- Directory Detail Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        <!-- Main Content (Left Column) -->
        <article
          class="lg:col-span-2 space-y-6"
          itemscope
          itemtype="https://schema.org/Product"
        >
          <!-- Header with Logo and Title -->
          <header class="bg-white rounded-xl sm:rounded-lg shadow-sm p-4 sm:p-6 md:p-8">
            <div
              class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6"
            >
              <!-- Logo -->
              <div class="flex-shrink-0">
                {
                  directory.logo_url ? (
                    <img
                      src={directory.logo_url}
                      alt={`${directory.name} logo`}
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl object-cover bg-gray-100 ring-2 ring-gray-200"
                      width="96"
                      height="96"
                      loading="eager"
                      itemprop="image"
                    />
                  ) : (
                    <div
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl bg-primary bg-opacity-10 flex items-center justify-center text-4xl sm:text-5xl ring-2 ring-gray-200"
                      aria-hidden="true"
                    >
                      📂
                    </div>
                  )
                }
              </div>

              <!-- Title and Meta -->
              <div class="flex-1 min-w-0">
                <h1
                  class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-2 sm:mb-3"
                  itemprop="name"
                >
                  {directory.name}
                </h1>

                <!-- Rating Display -->
                <div class="flex items-center gap-3 mb-4">
                  {
                    directory.average_rating ? (
                      <div class="flex items-center">
                        <div class="flex">
                          {[1, 2, 3, 4, 5].map((star) => (
                            <span
                              class={`text-lg ${star <= Math.round(directory.average_rating || 0) ? "text-yellow-400" : "text-gray-300"}`}
                            >
                              ★
                            </span>
                          ))}
                        </div>
                        <span class="ml-2 font-semibold text-gray-900">
                          {directory.average_rating.toFixed(1)}
                        </span>
                        <span class="ml-1 text-sm text-gray-500">
                          ({directory.rating_count || 0} reviews)
                        </span>
                      </div>
                    ) : (
                      <span class="text-sm text-gray-500">No ratings yet</span>
                    )
                  }
                </div>

                <!-- Badges -->
                <div class="flex flex-wrap items-center gap-2 mb-4">
                  {
                    directory.domain_rating && (
                      <span
                        class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold ${getDrBadgeClass(directory.domain_rating)}`}
                      >
                        DR: {directory.domain_rating}
                      </span>
                    )
                  }

                  {
                    directory.is_dofollow && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                        Dofollow
                      </span>
                    )
                  }

                  {
                    !directory.is_dofollow && (
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-700">
                        Nofollow
                      </span>
                    )
                  }

                  {
                    directory.traffic_estimate && (
                      <span
                        class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold ${getTrafficBadgeClass(directory.traffic_estimate)}`}
                      >
                        {getTrafficLabel(directory.traffic_estimate)} Traffic
                      </span>
                    )
                  }
                </div>

                <!-- Categories -->
                {
                  directory.categories && directory.categories.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {directory.categories.map((category) => (
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-700">
                          {category}
                        </span>
                      ))}
                    </div>
                  )
                }
              </div>

              <!-- Primary CTA -->
              {
                (directory.submission_url || directory.url) && (
                  <div class="flex-shrink-0 w-full sm:w-auto mt-2 sm:mt-0">
                    <a
                      href={`${directory.submission_url || directory.url}?ref=awesome-directories.com`}

                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3.5 sm:py-3 bg-primary hover:bg-primary-dark active:bg-primary-dark text-white font-semibold rounded-xl sm:rounded-lg transition-colors shadow-md hover:shadow-lg focus:outline-none focus-visible:ring-4 focus-visible:ring-primary focus-visible:ring-opacity-50 min-h-[52px] sm:min-h-[48px] touch-manipulation"
                      itemprop="url"
                    >
                      Submit Product →
                    </a>
                  </div>
                )
              }
            </div>
          </header>

          <!-- Submission Info -->
          {
            hasSubmissionInfo && (
              <section
                class="bg-white rounded-xl sm:rounded-lg shadow-sm p-4 sm:p-6 md:p-8"
                aria-labelledby="submission-heading"
              >
                <h2
                  id="submission-heading"
                  class="text-lg sm:text-xl font-bold text-gray-900 mb-3 sm:mb-4"
                >
                  Submission Details
                </h2>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                  <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                    <div class="text-lg sm:text-2xl font-bold text-gray-900">
                      {getPricingLabel(directory)}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600 mt-1">Pricing</div>
                  </div>

                  <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                    <div class="text-lg sm:text-2xl font-bold text-gray-900">
                      {directory.is_dofollow ? "Yes" : "No"}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600 mt-1">Dofollow Link</div>
                  </div>

                  <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                    <div
                      class="text-lg sm:text-2xl font-bold text-gray-900"
                      title={directory.avg_approval_days ? `${directory.avg_approval_days} days` : "Not available"}
                      aria-label={directory.avg_approval_days ? `${directory.avg_approval_days} days` : "Not available"}
                    >
                      {directory.avg_approval_days
                        ? `${directory.avg_approval_days}d`
                        : "N/A"}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600 mt-1">Avg. Approval</div>
                  </div>

                  <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                    <div class="text-lg sm:text-2xl font-bold text-gray-900">
                      {getTrafficLabel(directory.traffic_estimate) || "N/A"}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600 mt-1">Traffic Level</div>
                  </div>
                </div>
              </section>
            )
          }

          <!-- SEO & Authority Metrics -->
          {
            hasSeoMetrics && (
              <section
                class="bg-white rounded-xl sm:rounded-lg shadow-sm p-4 sm:p-6 md:p-8"
                aria-labelledby="seo-heading"
              >
                <h2
                  id="seo-heading"
                  class="text-lg sm:text-xl font-bold text-gray-900 mb-3 sm:mb-4"
                >
                  SEO & Authority Metrics
                </h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
                  {directory.domain_rating && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div class="text-2xl sm:text-3xl font-bold text-primary">
                        {directory.domain_rating}
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">
                        Domain Rating
                      </div>
                    </div>
                  )}

                  {directory.organic_search_traffic && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div class="text-2xl sm:text-3xl font-bold text-primary">
                        {formatNumber(directory.organic_search_traffic)}
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">
                        Monthly Traffic
                      </div>
                    </div>
                  )}

                  {directory.ranking_keywords && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div class="text-2xl sm:text-3xl font-bold text-primary">
                        {formatNumber(directory.ranking_keywords)}
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">
                        Keywords
                      </div>
                    </div>
                  )}

                  {directory.backlinks_count && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div class="text-2xl sm:text-3xl font-bold text-primary">
                        {formatNumber(directory.backlinks_count)}
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">Backlinks</div>
                    </div>
                  )}

                  {directory.referring_domains && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div class="text-2xl sm:text-3xl font-bold text-primary">
                        {formatNumber(directory.referring_domains)}
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">
                        Ref. Domains
                      </div>
                    </div>
                  )}

                  {getTrustScore(directory.spam_score) !== null && (
                    <div class="text-center p-3 sm:p-4 bg-gray-50 rounded-xl sm:rounded-lg">
                      <div
                        class={`text-2xl sm:text-3xl font-bold ${getTrustScore(directory.spam_score) >= 70 ? "text-green-600" : getTrustScore(directory.spam_score) >= 40 ? "text-yellow-600" : "text-red-600"}`}
                      >
                        {getTrustScore(directory.spam_score)}%
                      </div>
                      <div class="text-xs sm:text-sm text-gray-600 mt-1">Trust Score</div>
                    </div>
                  )}
                </div>
              </section>
            )
          }

          <!-- Description -->
          {
            directory.description && (
              <section
                class="bg-white rounded-lg shadow-sm p-6 sm:p-8"
                aria-labelledby="description-heading"
              >
                <h2
                  id="description-heading"
                  class="text-xl font-bold text-gray-900 mb-4"
                >
                  About {directory.name}
                </h2>
                <p class="text-gray-700 leading-relaxed" itemprop="description">
                  {directory.description}
                </p>
              </section>
            )
          }

          <!-- Quick Links -->
          <section class="bg-white rounded-xl sm:rounded-lg shadow-sm p-4 sm:p-6 md:p-8">
            <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-3 sm:mb-4">Quick Links</h2>
            <div class="flex flex-col sm:flex-row flex-wrap gap-3">
              {
                directory.url && (
                  <a
                    href={`${directory.url}?ref=awesome-directories.com`}
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center px-4 py-3 sm:py-2 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 text-gray-700 font-medium rounded-xl sm:rounded-lg transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation"
                  >
                    <span class="mr-2" aria-hidden="true">🌐</span> Visit Website
                  </a>
                )
              }
              {
                directory.submission_url &&
                  directory.submission_url !== directory.url && (
                    <a
                      href={directory.submission_url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="inline-flex items-center justify-center px-4 py-3 sm:py-2 bg-primary hover:bg-primary-dark active:bg-primary-dark text-white font-medium rounded-xl sm:rounded-lg transition-colors min-h-[48px] sm:min-h-[44px] touch-manipulation"
                    >
                      <span class="mr-2" aria-hidden="true">📤</span> Submit Product
                    </a>
                  )
              }
            </div>
          </section>
        </article>

        <!-- Actions Sidebar (Right Column) -->
        <aside class="lg:col-span-1">
          <div class="sticky top-24">
            <DirectoryDetailActions
              client:load
              directoryId={directory.id}
              averageRating={directory.average_rating || null}
              ratingCount={directory.rating_count || 0}
              reviewCount={directory.review_count || 0}
            />
          </div>
        </aside>
      </div>
    </div>

    <!-- Related Directories -->
    {
      relatedDirectories.length > 0 && (
        <section
          class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-gray-200"
          aria-labelledby="related-heading"
        >
          <h2
            id="related-heading"
            class="text-2xl font-bold text-gray-900 mb-6"
          >
            Related Directories
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedDirectories.map((related) => (
              <article class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow">
                <a href={`/directory/${related.slug}`} class="block group">
                  <div class="flex items-center gap-4 mb-3">
                    {related.logo_url ? (
                      <img
                        src={related.logo_url}
                        alt={`${related.name} logo`}
                        class="w-12 h-12 rounded-lg object-cover bg-gray-100"
                        width="48"
                        height="48"
                        loading="lazy"
                      />
                    ) : (
                      <div
                        class="w-12 h-12 rounded-lg bg-primary bg-opacity-10 flex items-center justify-center text-2xl"
                        aria-hidden="true"
                      >
                        📂
                      </div>
                    )}
                    <div class="flex-1 min-w-0">
                      <h3 class="font-bold text-lg text-gray-900 group-hover:text-primary transition-colors">
                        {related.name}
                      </h3>
                      {related.average_rating != null ? (
                        <div class="flex items-center text-sm">
                          <span class="text-yellow-400">★</span>
                          <span class="ml-1 text-gray-600">
                            {related.average_rating.toFixed(1)}
                          </span>
                        </div>
                      ) : null}
                    </div>
                  </div>

                  {related.description && (
                    <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                      {related.description}
                    </p>
                  )}

                  <div class="flex flex-wrap items-center gap-2">
                    {related.domain_rating && (
                      <span
                        class={`inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold ${getDrBadgeClass(related.domain_rating)}`}
                      >
                        DR: {related.domain_rating}
                      </span>
                    )}

                    {related.is_dofollow && (
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                        Dofollow
                      </span>
                    )}

                    {related.pricing_type && (
                      <span
                        class={`inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold ${getPricingBadgeClass(related.pricing_type)}`}
                      >
                        {getPricingLabel(related)}
                      </span>
                    )}
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <AppFooter />
</BaseLayout>


