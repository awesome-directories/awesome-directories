---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppHeader from '@/components/AppHeader.astro';
import AppFooter from '@/components/AppFooter.astro';
import { getUniqueCategories, getAllDirectories } from '@/lib/data/directories.js';
import "@/style.css";

const allDirectories = await getAllDirectories();
const allCategories = getUniqueCategories(allDirectories).filter(cat => cat !== 'All');

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Submit Directory - Awesome Directories',
    description: 'Submit a new directory to our curated collection.',
    url: 'https://awesome-directories.com/submit',
  },
];
---

<BaseLayout
  title="Submit a Directory - Awesome Directories"
  description="Know a great directory? Submit it for review and help the community discover valuable resources."
  structuredData={structuredData}
>
  <AppHeader />

  <main class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-3xl mx-auto px-4">
      <!-- Header -->
      <div class="mb-8">
        <nav class="mb-4 text-sm">
          <a href="/" class="text-primary hover:text-primary-dark">← Back to home</a>
        </nav>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Submit a Directory</h1>
        <p class="text-lg text-gray-600">
          Know a great directory? Share it with the community! We'll review your submission and add it to our collection.
        </p>
      </div>

      <!-- Auth Check Message -->
      <div id="auth-message" class="hidden mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <p class="text-yellow-800">
          🔒 Please sign in to submit a directory.
          <button id="sign-in-trigger" class="text-primary hover:text-primary-dark font-semibold underline ml-2">
            Sign In
          </button>
        </p>
      </div>

      <!-- Success Message -->
      <div id="success-message" class="hidden mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-green-800">
          ✅ <strong>Success!</strong> Your directory has been submitted for review. We'll notify you once it's approved.
        </p>
      </div>

      <!-- Error Message -->
      <div id="error-message" class="hidden mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-800">
          ❌ <strong>Error:</strong> <span id="error-text"></span>
        </p>
      </div>

      <!-- Submission Form -->
      <div class="bg-white rounded-lg shadow-md p-8">
        <form id="submit-form" class="space-y-6">
          <!-- Name -->
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
              Directory Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="e.g., Product Hunt"
            />
          </div>

          <!-- URL -->
          <div>
            <label for="url" class="block text-sm font-semibold text-gray-700 mb-2">
              Directory URL <span class="text-red-500">*</span>
            </label>
            <input
              type="url"
              id="url"
              name="url"
              required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="https://www.producthunt.com"
            />
          </div>

          <!-- Description -->
          <div>
            <label for="description" class="block text-sm font-semibold text-gray-700 mb-2">
              Description <span class="text-red-500">*</span>
            </label>
            <textarea
              id="description"
              name="description"
              required
              rows="4"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="Describe what makes this directory valuable..."
            ></textarea>
            <p class="text-sm text-gray-500 mt-1">Minimum 50 characters</p>
          </div>

          <!-- Logo URL (Optional) -->
          <div>
            <label for="logo_url" class="block text-sm font-semibold text-gray-700 mb-2">
              Logo URL (Optional)
            </label>
            <input
              type="url"
              id="logo_url"
              name="logo_url"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="https://example.com/logo.png"
            />
          </div>

          <!-- Submission URL (Optional) -->
          <div>
            <label for="submission_url" class="block text-sm font-semibold text-gray-700 mb-2">
              Submission Page URL (Optional)
            </label>
            <input
              type="url"
              id="submission_url"
              name="submission_url"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="https://www.producthunt.com/posts/new"
            />
            <p class="text-sm text-gray-500 mt-1">Direct link to submit page if different from main URL</p>
          </div>

          <!-- Categories -->
          <div>
            <label for="categories" class="block text-sm font-semibold text-gray-700 mb-2">
              Categories (Select all that apply)
            </label>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-2 max-h-48 overflow-y-auto border border-gray-200 rounded-lg p-4">
              {allCategories.map((category) => (
                <label class="flex items-center gap-2 text-sm">
                  <input
                    type="checkbox"
                    name="categories"
                    value={category}
                    class="rounded text-primary focus:ring-primary"
                  />
                  <span class="text-gray-700">{category}</span>
                </label>
              ))}
            </div>
          </div>

          <!-- Pricing Type -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Pricing Type <span class="text-red-500">*</span>
            </label>
            <div class="space-y-2">
              <label class="flex items-center gap-2">
                <input
                  type="radio"
                  name="pricing_type"
                  value="free"
                  required
                  class="text-primary focus:ring-primary"
                />
                <span class="text-gray-700">💰 Free - Completely free to submit</span>
              </label>
              <label class="flex items-center gap-2">
                <input
                  type="radio"
                  name="pricing_type"
                  value="freemium"
                  class="text-primary focus:ring-primary"
                />
                <span class="text-gray-700">💰 Freemium - Free with optional paid upgrades</span>
              </label>
              <label class="flex items-center gap-2">
                <input
                  type="radio"
                  name="pricing_type"
                  value="paid"
                  class="text-primary focus:ring-primary"
                />
                <span class="text-gray-700">💰 Paid - Requires payment</span>
              </label>
            </div>
          </div>

          <!-- Pricing Amount (Conditional) -->
          <div id="pricing-amount-container" class="hidden">
            <label for="pricing_amount" class="block text-sm font-semibold text-gray-700 mb-2">
              Pricing Amount (USD)
            </label>
            <input
              type="number"
              id="pricing_amount"
              name="pricing_amount"
              min="0"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="e.g., 49"
            />
          </div>

          <!-- Traffic Estimate -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Estimated Traffic (Optional)
            </label>
            <select
              name="traffic_estimate"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
            >
              <option value="">Select if known...</option>
              <option value="high">High (100K+ monthly visits)</option>
              <option value="medium">Medium (10K-100K monthly visits)</option>
              <option value="low">Low (< 10K monthly visits)</option>
            </select>
          </div>

          <!-- Domain Rating (Optional) -->
          <div>
            <label for="domain_rating" class="block text-sm font-semibold text-gray-700 mb-2">
              Domain Rating (Optional)
            </label>
            <input
              type="number"
              id="domain_rating"
              name="domain_rating"
              min="0"
              max="100"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="e.g., 85"
            />
            <p class="text-sm text-gray-500 mt-1">From Ahrefs or Moz (0-100)</p>
          </div>

          <!-- Is Dofollow -->
          <div>
            <label class="flex items-center gap-2">
              <input
                type="checkbox"
                id="is_dofollow"
                name="is_dofollow"
                class="rounded text-primary focus:ring-primary"
              />
              <span class="text-sm font-semibold text-gray-700">
                🔗 This directory provides dofollow links
              </span>
            </label>
          </div>

          <!-- Avg Approval Days (Optional) -->
          <div>
            <label for="avg_approval_days" class="block text-sm font-semibold text-gray-700 mb-2">
              Average Approval Time (Days, Optional)
            </label>
            <input
              type="number"
              id="avg_approval_days"
              name="avg_approval_days"
              min="0"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              placeholder="e.g., 7"
            />
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-primary text-white font-semibold py-3 px-6 rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Submit for Review
            </button>
          </div>
        </form>
      </div>

      <!-- Submission Guidelines -->
      <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
        <h3 class="font-semibold text-blue-900 mb-3">📝 Submission Guidelines</h3>
        <ul class="space-y-2 text-blue-800 text-sm">
          <li>✓ Only submit legitimate, active directories</li>
          <li>✓ Provide accurate information (we verify all submissions)</li>
          <li>✓ Include a clear, detailed description</li>
          <li>✓ Check for duplicates before submitting</li>
          <li>✓ Submissions are typically reviewed within 3-5 business days</li>
        </ul>
      </div>
    </div>
  </main>

  <AppFooter />

  <script>
    import { supabase } from '@/lib/supabase-client.js';
    import { userStore } from '@/stores/auth.js';

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('submit-form');
      const submitBtn = document.getElementById('submit-btn');
      const authMessage = document.getElementById('auth-message');
      const successMessage = document.getElementById('success-message');
      const errorMessage = document.getElementById('error-message');
      const errorText = document.getElementById('error-text');
      const pricingAmountContainer = document.getElementById('pricing-amount-container');

      // Check auth status
      let currentUser = null;
      userStore.subscribe(user => {
        currentUser = user;
        if (!user) {
          authMessage.classList.remove('hidden');
          form.classList.add('opacity-50', 'pointer-events-none');
        } else {
          authMessage.classList.add('hidden');
          form.classList.remove('opacity-50', 'pointer-events-none');
        }
      });

      // Sign in trigger
      document.getElementById('sign-in-trigger')?.addEventListener('click', () => {
        // Trigger auth modal (we'll integrate this when adding AuthModal)
        window.dispatchEvent(new CustomEvent('open-auth-modal'));
      });

      // Show/hide pricing amount based on pricing type
      const pricingInputs = document.querySelectorAll('input[name="pricing_type"]');
      pricingInputs.forEach(input => {
        input.addEventListener('change', (e) => {
          if (e.target.value === 'paid') {
            pricingAmountContainer.classList.remove('hidden');
          } else {
            pricingAmountContainer.classList.add('hidden');
            document.getElementById('pricing_amount').value = '';
          }
        });
      });

      // Form submission
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!currentUser) {
          errorText.textContent = 'Please sign in to submit a directory.';
          errorMessage.classList.remove('hidden');
          return;
        }

        try {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
          successMessage.classList.add('hidden');
          errorMessage.classList.add('hidden');

          const formData = new FormData(form);

          // Validate description length
          const description = formData.get('description');
          if (description.length < 50) {
            throw new Error('Description must be at least 50 characters long.');
          }

          // Get selected categories
          const categories = Array.from(formData.getAll('categories'));

          // Prepare submission data
          const submission = {
            user_id: currentUser.id,
            user_email: currentUser.email,
            name: formData.get('name'),
            url: formData.get('url'),
            description: formData.get('description'),
            logo_url: formData.get('logo_url') || null,
            submission_url: formData.get('submission_url') || null,
            categories: categories,
            pricing_type: formData.get('pricing_type'),
            pricing_amount: formData.get('pricing_amount') ? parseInt(formData.get('pricing_amount')) : null,
            traffic_estimate: formData.get('traffic_estimate') || null,
            domain_rating: formData.get('domain_rating') ? parseInt(formData.get('domain_rating')) : null,
            is_dofollow: formData.get('is_dofollow') === 'on',
            avg_approval_days: formData.get('avg_approval_days') ? parseInt(formData.get('avg_approval_days')) : null,
          };

          // Submit to Supabase
          const { error } = await supabase
            .from('pending_directories')
            .insert(submission);

          if (error) {
            // Check for duplicate submission
            if (error.code === '23505') {
              throw new Error('You have already submitted this directory. Please check your submissions page.');
            }
            throw error;
          }

          // Success!
          successMessage.classList.remove('hidden');
          form.reset();
          window.scrollTo({ top: 0, behavior: 'smooth' });

        } catch (error) {
          console.error('Submission error:', error);
          errorText.textContent = error.message || 'An unexpected error occurred. Please try again.';
          errorMessage.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit for Review';
        }
      });
    });
  </script>
</BaseLayout>
