---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppHeader from '@/components/AppHeader.astro';
import AppFooter from '@/components/AppFooter.astro';
import AuthGate from '@/components/AuthGate.astro';

const availableCategories = [
  'SaaS',
  'Startups',
  'Developers',
  'AI/ML',
  'No-Code',
  'Mobile Apps',
  'Web Apps',
  'Design',
  'Marketing',
  'Productivity',
  'E-commerce',
  'Content',
];

const pricingTypes = [
  {
    value: 'free',
    label: 'Free',
    description: 'Completely free to submit',
  },
  {
    value: 'freemium',
    label: 'Freemium',
    description: 'Free option available with paid upgrades',
  },
  {
    value: 'paid',
    label: 'Paid',
    description: 'Requires payment to submit',
  },
];
---

<BaseLayout
  title="Submit a Directory | Awesome Directories"
  description="Help the community by contributing high-quality directories to Awesome Directories"
>
  <AppHeader />

  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Submit a Directory</h1>
      <p class="text-xl text-gray-600 mb-8">
        Help the community by contributing high-quality directories
      </p>

      <!-- Auth Gate (shown when not authenticated) -->
      <div id="auth-gate-container">
        <AuthGate
          title="Authentication Required"
          description="Please sign in to submit a directory for review"
        />
      </div>

      <!-- Submission Success Message -->
      <div
        id="submission-success"
        class="hidden card p-8 text-center bg-green-50 border-green-200"
      >
        <div class="text-6xl mb-4">✅</div>
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          Submission Received!
        </h2>
        <p class="text-gray-700 mb-4">
          Thank you for submitting <strong id="submitted-name"></strong> to Awesome
          Directories.
        </p>
        <div class="bg-white rounded-lg p-6 mb-6 text-left">
          <h3 class="font-semibold text-gray-900 mb-3">What happens next:</h3>
          <ul class="space-y-2 text-gray-700">
            <li class="flex items-start">
              <svg
                class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span
                >Your submission is now in our review queue and will be reviewed
                by our team</span
              >
            </li>
            <li class="flex items-start">
              <svg
                class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span
                >Once approved, your directory will go live on Awesome
                Directories</span
              >
            </li>
            <li class="flex items-start">
              <svg
                class="w-5 h-5 text-green-600 mr-2 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span
                >You'll receive an email notification about the status of your
                submission within 24 hours</span
              >
            </li>
          </ul>
        </div>
        <div class="flex gap-4 justify-center">
          <button id="submit-another" class="btn-primary">
            Submit Another Directory
          </button>
          <a href="/" class="btn-secondary"> Browse Directories </a>
        </div>
      </div>

      <!-- Submission Form -->
      <form id="submit-form" class="hidden space-y-6">
        <!-- Guidelines Card -->
        <div class="card p-6 bg-blue-50 border-blue-200">
          <h3 class="font-semibold text-gray-900 mb-2">
            Submission Guidelines
          </h3>
          <ul class="text-sm text-gray-700 space-y-1">
            <li>✅ Domain Rating (DR) of 60 or higher preferred</li>
            <li>✅ Active directory with no dead links</li>
            <li>✅ Quality focus, not just link farms</li>
            <li>✅ Relevant to startups, SaaS, or developers</li>
            <li>✅ Free or freemium submission option available</li>
          </ul>
        </div>

        <!-- Basic Information -->
        <div class="card p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            Basic Information
          </h2>

          <div class="space-y-6">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Directory Name <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                placeholder="e.g., Product Hunt"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>

            <div>
              <label
                for="url"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Directory URL <span class="text-red-500">*</span>
              </label>
              <input
                id="url"
                name="url"
                type="url"
                required
                placeholder="https://example.com"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
              <p class="text-sm text-gray-500 mt-1">
                The main homepage of the directory
              </p>
            </div>

            <div>
              <label
                for="description"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Description <span class="text-red-500">*</span>
              </label>
              <textarea
                id="description"
                name="description"
                required
                rows="4"
                placeholder="Brief description of the directory (1-2 sentences)"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              ></textarea>
            </div>

            <div>
              <label
                for="submission_url"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Submission Page URL
              </label>
              <input
                id="submission_url"
                name="submission_url"
                type="url"
                placeholder="https://example.com/submit"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
              <p class="text-sm text-gray-500 mt-1">
                Direct link to where users can submit their products
              </p>
            </div>

            <div>
              <label
                for="logo_url"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Logo URL
              </label>
              <input
                id="logo_url"
                name="logo_url"
                type="url"
                placeholder="https://example.com/logo.png"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>
          </div>
        </div>

        <!-- Categories & Pricing -->
        <div class="card p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            Categories & Pricing
          </h2>

          <div class="space-y-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Categories <span class="text-red-500">*</span>
              </label>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                {
                  availableCategories.map((category) => (
                    <label class="flex items-center space-x-2 cursor-pointer">
                      <input
                        type="checkbox"
                        name="categories"
                        value={category}
                        class="rounded border-gray-300 text-primary focus:ring-primary"
                      />
                      <span class="text-sm text-gray-700">{category}</span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">
                Pricing Type <span class="text-red-500">*</span>
              </label>
              <div class="space-y-2">
                {
                  pricingTypes.map((type) => (
                    <label class="flex items-center space-x-3 cursor-pointer">
                      <input
                        type="radio"
                        name="pricing_type"
                        value={type.value}
                        required
                        class="border-gray-300 text-primary focus:ring-primary"
                      />
                      <div>
                        <span class="text-sm font-medium text-gray-700">
                          {type.label}
                        </span>
                        <p class="text-xs text-gray-500">{type.description}</p>
                      </div>
                    </label>
                  ))
                }
              </div>
            </div>

            <div id="pricing-amount-container" class="hidden">
              <label
                for="pricing_amount"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Pricing Amount (USD)
              </label>
              <input
                id="pricing_amount"
                name="pricing_amount"
                type="number"
                min="0"
                placeholder="99"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>
          </div>
        </div>

        <!-- SEO Metrics (Optional) -->
        <div class="card p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">
            SEO Metrics
            <span class="text-sm font-normal text-gray-500">(Optional)</span>
          </h2>
          <p class="text-sm text-gray-600 mb-6">
            Help us understand the SEO value of this directory
          </p>

          <div class="space-y-6">
            <div>
              <label
                for="domain_rating"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Domain Rating (Ahrefs DR)
              </label>
              <input
                id="domain_rating"
                name="domain_rating"
                type="number"
                min="0"
                max="100"
                placeholder="e.g., 75"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>

            <div>
              <label class="flex items-center space-x-2 cursor-pointer">
                <input
                  type="checkbox"
                  name="is_dofollow"
                  class="rounded border-gray-300 text-primary focus:ring-primary"
                />
                <span class="text-sm font-medium text-gray-700"
                  >Directory provides dofollow backlinks</span
                >
              </label>
            </div>

            <div>
              <label
                for="traffic_estimate"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Traffic Estimate
              </label>
              <select
                id="traffic_estimate"
                name="traffic_estimate"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              >
                <option value="">Select traffic level</option>
                <option value="high">High (100K+ monthly visitors)</option>
                <option value="medium">Medium (10K-100K monthly visitors)</option>
                <option value="low">Low (&lt;10K monthly visitors)</option>
              </select>
            </div>

            <div>
              <label
                for="avg_approval_days"
                class="block text-sm font-medium text-gray-700 mb-2"
              >
                Average Approval Time (days)
              </label>
              <input
                id="avg_approval_days"
                name="avg_approval_days"
                type="number"
                min="0"
                placeholder="e.g., 7"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
              />
            </div>
          </div>
        </div>

        <!-- Error Message -->
        <div id="error-message" class="hidden card p-4 bg-red-50 border-red-200">
          <p class="text-sm text-red-600" id="error-text"></p>
        </div>

        <!-- Submit Button -->
        <div class="flex gap-4">
          <button
            type="submit"
            id="submit-button"
            class="btn-primary flex-1 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Submit Directory for Review
          </button>
          <a href="/" class="btn-secondary"> Cancel </a>
        </div>
      </form>
    </div>
  </main>

  <AppFooter />
</BaseLayout>

<script>
  import { supabase, getUser } from '@/lib/supabase-client';
  import { $user } from '@/stores/auth';

  // DOM elements
  const authGateContainer = document.getElementById('auth-gate-container');
  const submitForm = document.getElementById('submit-form') as HTMLFormElement;
  const submissionSuccess = document.getElementById('submission-success');
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const errorMessage = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  const submittedName = document.getElementById('submitted-name');
  const submitAnotherButton = document.getElementById('submit-another');
  const pricingAmountContainer = document.getElementById('pricing-amount-container');

  // Check auth status and show appropriate UI
  async function checkAuthStatus() {
    const user = await getUser();

    if (user) {
      authGateContainer?.classList.add('hidden');
      submitForm?.classList.remove('hidden');
    } else {
      authGateContainer?.classList.remove('hidden');
      submitForm?.classList.add('hidden');
    }
  }

  // Listen to auth state changes
  supabase.auth.onAuthStateChange((event, session) => {
    if (session?.user) {
      authGateContainer?.classList.add('hidden');
      submitForm?.classList.remove('hidden');
    } else {
      authGateContainer?.classList.remove('hidden');
      submitForm?.classList.add('hidden');
    }
  });

  // Show/hide pricing amount input based on pricing type
  const pricingInputs = document.querySelectorAll('input[name="pricing_type"]');
  pricingInputs.forEach((input) => {
    input.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value === 'paid') {
        pricingAmountContainer?.classList.remove('hidden');
        const amountInput = document.getElementById('pricing_amount') as HTMLInputElement;
        amountInput.required = true;
      } else {
        pricingAmountContainer?.classList.add('hidden');
        const amountInput = document.getElementById('pricing_amount') as HTMLInputElement;
        amountInput.required = false;
      }
    });
  });

  // Handle form submission
  submitForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const user = $user.get();
    if (!user) {
      window.dispatchEvent(new CustomEvent('show-auth-modal'));
      return;
    }

    // Get form data
    const formData = new FormData(submitForm);
    const categories = formData.getAll('categories');

    if (categories.length === 0) {
      showError('Please select at least one category');
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Submitting...';
    hideError();

    try {
      const { error } = await supabase.from('pending_directories').insert([
        {
          user_id: user.id,
          user_email: user.email,
          name: formData.get('name'),
          description: formData.get('description'),
          url: formData.get('url'),
          logo_url: formData.get('logo_url') || null,
          submission_url: formData.get('submission_url') || null,
          categories: categories,
          pricing_type: formData.get('pricing_type'),
          pricing_amount: formData.get('pricing_amount') ? parseInt(formData.get('pricing_amount') as string) : null,
          domain_rating: formData.get('domain_rating') ? parseInt(formData.get('domain_rating') as string) : null,
          is_dofollow: formData.get('is_dofollow') === 'on',
          traffic_estimate: formData.get('traffic_estimate') || null,
          avg_approval_days: formData.get('avg_approval_days') ? parseInt(formData.get('avg_approval_days') as string) : null,
          status: 'pending',
        },
      ]);

      if (error) {
        if (error.code === '23505') {
          showError("You've already submitted this directory. Please check your submissions page.");
        } else {
          throw error;
        }
        return;
      }

      // Show success message
      if (submittedName) submittedName.textContent = formData.get('name') as string;
      submitForm.classList.add('hidden');
      submissionSuccess?.classList.remove('hidden');

      // Track submission in analytics
      if (window.pirsch) {
        window.pirsch('Directory Submitted', {
          directory_name: formData.get('name'),
          pricing_type: formData.get('pricing_type'),
        });
      }
    } catch (err) {
      console.error('Error submitting directory:', err);
      showError('Failed to submit directory. Please try again or contact support if the problem persists.');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Submit Directory for Review';
    }
  });

  // Submit another button
  submitAnotherButton?.addEventListener('click', () => {
    submitForm?.reset();
    submissionSuccess?.classList.add('hidden');
    submitForm?.classList.remove('hidden');
    pricingAmountContainer?.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Error handling functions
  function showError(message: string) {
    if (errorText) errorText.textContent = message;
    errorMessage?.classList.remove('hidden');
    window.scrollTo({ top: errorMessage?.offsetTop || 0, behavior: 'smooth' });
  }

  function hideError() {
    errorMessage?.classList.add('hidden');
  }

  // Check auth status on load
  checkAuthStatus();
</script>
