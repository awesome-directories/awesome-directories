---
interface Props {
  platform: 'x' | 'linkedin' | 'facebook' | 'reddit' | 'hackernews';
  url: string;
  title: string;
  description?: string;
  class?: string;
}

const { platform, url, title, description = '', class: className = '' } = Astro.props;

const platformConfigs = {
  x: {
    label: 'Share on X',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
    bgColor: 'bg-black',
    hoverColor: 'hover:bg-gray-800',
    shareUrl: function buildUrl(u, t) {
      return 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(t) + '&url=' + encodeURIComponent(u);
    }
  },
  linkedin: {
    label: 'Share on LinkedIn',
    icon: 'M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z',
    bgColor: 'bg-[#0077b5]',
    hoverColor: 'hover:bg-[#006399]',
    shareUrl: function buildUrl(u) {
      return 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(u);
    }
  },
  facebook: {
    label: 'Share on Facebook',
    icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
    bgColor: 'bg-[#1877f2]',
    hoverColor: 'hover:bg-[#166fe5]',
    shareUrl: function buildUrl(u) {
      return 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u);
    }
  },
  reddit: {
    label: 'Share on Reddit',
    icon: 'M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z',
    bgColor: 'bg-[#ff4500]',
    hoverColor: 'hover:bg-[#ff5722]',
    shareUrl: function buildUrl(u, t) {
      return 'https://www.reddit.com/submit?url=' + encodeURIComponent(u) + '&title=' + encodeURIComponent(t);
    }
  },
  hackernews: {
    label: 'Share on Hacker News',
    icon: 'M0 0v24h24V0H0zm12.5 13.5l3.5-6h2L14 14v4h-2v-4l-4-6.5h2l3.5 6z',
    bgColor: 'bg-[#ff6600]',
    hoverColor: 'hover:bg-[#ff7a1a]',
    shareUrl: function buildUrl(u, t) {
      return 'https://news.ycombinator.com/submitlink?u=' + encodeURIComponent(u) + '&t=' + encodeURIComponent(t);
    }
  }
};

const config = platformConfigs[platform];
const shareUrl = config.shareUrl(url, title, description);
---

<a
  href={shareUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center gap-2 px-4 py-2 rounded-lg text-white font-medium transition-all duration-200 transform hover:scale-105 active:scale-95 ${config.bgColor} ${config.hoverColor} ${className}`}
  aria-label={config.label}
>
  <svg
    class="w-5 h-5"
    viewBox="0 0 24 24"
    fill="currentColor"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d={config.icon}></path>
  </svg>
  <span class="text-sm">{config.label}</span>
</a>
