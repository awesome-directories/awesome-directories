---
import type { CollectionEntry } from "astro:content";
import { formatDate, calculateReadingTime, getPostSlug } from "@/utils/blog";

interface Props {
  post: CollectionEntry<"blog">;
}

var { post } = Astro.props;
var { title, description, date, tags, author, coverImage, coverImageAlt } =
  post.data;
var readingTime = calculateReadingTime(post.body);
var postSlug = getPostSlug(post);
---

<article
  class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300"
>
  {
    coverImage && (
      <a href={`/blog/${postSlug}`} class="block">
        <img
          src={coverImage}
          alt={coverImageAlt || title}
          class="w-full h-48 object-cover"
          loading="lazy"
        />
      </a>
    )
  }

  <div class="p-6">
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
      <time datetime={date.toISOString()}>
        {formatDate(date)}
      </time>
      <span>•</span>
      <span>{readingTime} min read</span>
    </div>

    <a href={`/blog/${postSlug}`} class="block group">
      <h2
        class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors"
      >
        {title}
      </h2>
    </a>

    <p class="text-gray-600 mb-4 line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-2 mb-4">
      {
        tags.slice(0, 3).map(function mapTags(tag) {
          return (
            <a
              href={`/blog/tags/${tag.toLowerCase()}`}
              class="inline-block px-3 py-1 text-sm bg-blue-100 text-blue-800 rounded-full hover:bg-blue-200 transition-colors"
            >
              #{tag}
            </a>
          );
        })
      }
    </div>

    <div class="flex items-center justify-between text-sm text-gray-600">
      <span>By {author}</span>
      <a
        href={`/blog/${postSlug}`}
        class="text-blue-600 hover:text-blue-800 font-medium"
      >
        Read more →
      </a>
    </div>
  </div>
</article>
