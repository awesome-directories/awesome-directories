          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Altcha captcha widget script -->
<script type="module" src="https://newsletter.meysam.io/public/static/altcha.umd.js" async defer></script>

<style>
  /* Hide honeypot fields */
  .listmonk-honeypot {
    position: absolute !important;
    left: -9999px !important;
    top: -9999px !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Style the Altcha widget to match the dark theme */
  .altcha-widget {
    --altcha-color-base: #1f2937;
    --altcha-color-text: #d1d5db;
    --altcha-color-border: #374151;
    --altcha-color-border-focus: #3b82f6;
    --altcha-max-width: 100%;
  }
</style>

<script>
  var form = document.getElementById("newsletter-form") as HTMLFormElement;
  var emailInput = document.getElementById(
    "newsletter-email",
  ) as HTMLInputElement;
  var submitButton = document.getElementById(
    "newsletter-submit",
  ) as HTMLButtonElement;
  var buttonText = submitButton?.querySelector(".button-text");
  var buttonLoader = submitButton?.querySelector(".button-loader");
  var successMessage = document.getElementById("newsletter-success");
  var errorMessage = document.getElementById("newsletter-error");

  function setLoading(isLoading: boolean) {
    if (submitButton) submitButton.disabled = isLoading;
    buttonText?.classList.toggle("hidden", isLoading);
    buttonLoader?.classList.toggle("hidden", !isLoading);
  }

  form?.addEventListener("submit", async function handleSubmit(e) {
    e.preventDefault();

    var email = emailInput?.value;
    if (!email) return;

    setLoading(true);
    successMessage?.classList.add("hidden");
    errorMessage?.classList.add("hidden");

    try {
      var formData = new FormData(form);

      var response = await fetch(form.action, {
        method: "POST",
        body: formData,
        mode: "no-cors",
      });

      // With no-cors mode, we can't read the response, so we assume success
      // Listmonk will handle the actual subscription
      if (successMessage) {
        successMessage.textContent = "Thanks for subscribing! Please check your email to confirm.";
        successMessage.classList.remove("hidden");
      }
      emailInput.value = "";

      // Reset the Altcha widget for next submission
      var altchaWidget = form.querySelector("altcha-widget") as any;
      if (altchaWidget?.reset) {
        altchaWidget.reset();
      }

      // Track subscription event
      if (typeof window !== "undefined" && (window as any).pirsch) {
        (window as any).pirsch("Newsletter Signup", { source: "footer" });
      }
    } catch (error) {
      console.error("Newsletter signup error:", error);
      if (errorMessage) {
        errorMessage.textContent = "Failed to subscribe. Please try again.";
        errorMessage.classList.remove("hidden");
      }
    } finally {
      setLoading(false);
    }
  });
</script>
