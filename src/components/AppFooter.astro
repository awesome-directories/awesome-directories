---
var currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
      <div>
        <h2 class="text-white font-bold text-base sm:text-lg mb-3 sm:mb-4">
          Awesome Directories
        </h2>
        <p class="text-sm text-gray-300 mb-3 sm:mb-4 leading-relaxed">
          Hand-picked directories that actually drive traffic—filter by DR,
          export to CSV, and track submissions per project. Built by an indie
          hacker who got tired of garbage directory lists.
        </p>
        <p class="text-sm text-gray-300">
          Built by
          <a
            href="https://meysam.io"
            target="_blank"
            rel="noopener"
            class="text-blue-400 hover:text-blue-300 transition-colors underline"
          >
            Meysam
          </a>
        </p>
      </div>

      <div>
        <h2 class="text-white font-bold text-base sm:text-lg mb-3 sm:mb-4">
          Links
        </h2>
        <ul class="space-y-2 sm:space-y-2.5">
          <li>
            <a
              href="/about"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/submit"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              Submit Directory
            </a>
          </li>
          <li>
            <a
              href="/stats"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              Public Stats
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              Terms of Service
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="https://github.com/awesome-directories/awesome-directories"
              target="_blank"
              rel="noopener"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              GitHub Repository
            </a>
          </li>
          <li>
            <a
              href="https://github.com/sponsors/meysam81"
              target="_blank"
              rel="noopener"
              class="text-sm text-gray-300 hover:text-white transition-colors inline-block py-1"
            >
              💝 GitHub Sponsors
            </a>
          </li>
        </ul>
      </div>

      <div class="sm:col-span-2 lg:col-span-1">
        <h2 class="text-white font-bold text-base sm:text-lg mb-3 sm:mb-4">
          Don't Miss the Next High-DR Directory We Add
        </h2>
        <p class="text-sm text-gray-300 mb-3 leading-relaxed">
          We add new verified directories weekly. Be the first to know—plus get
          actionable launch strategies that actually work.
        </p>
        <form
          id="newsletter-form"
          class="space-y-3 listmonk-form"
          data-pirsch-event="subscribe"
          data-pirsch-meta-source="footer"
          data-pirsch-non-interactive
          action="https://newsletter.meysam.io/subscription/form"
          method="post"
        >
          <input type="hidden" name="nonce" />
          <input type="hidden" name="l" value="3a836c26-900d-4d3f-89d9-eba6943ca1ac" />

          <!-- Honeypot fields for spam protection -->
          <input type="text" name="name" value="" class="listmonk-honeypot" tabindex="-1" autocomplete="new-password" aria-hidden="true" />
          <input type="text" name="company" value="" class="listmonk-honeypot" tabindex="-1" autocomplete="new-password" aria-hidden="true" />
          <input type="text" name="website" value="" class="listmonk-honeypot" tabindex="-1" autocomplete="new-password" aria-hidden="true" />

          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            placeholder="Your email"
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent text-sm min-h-[44px]"
          />

          <altcha-widget
            class="altcha-widget"
            challengeurl="https://newsletter.meysam.io/api/public/captcha/altcha"
            auto="onfocus"
          ></altcha-widget>

          <button
            id="newsletter-submit"
            type="submit"
            class="w-full btn-primary min-h-[44px]"
          >
            <span class="button-text">Join 100+ Founders</span>
            <span class="button-loader hidden">
              <svg class="inline-block animate-spin mr-2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              </svg>
              Subscribing...
            </span>
          </button>

          <p id="newsletter-success" class="text-sm text-success hidden"></p>
          <p id="newsletter-error" class="text-sm text-danger hidden"></p>

          <p class="text-xs text-gray-400 leading-relaxed">
            One email per week. Unsubscribe anytime. We hate spam too.
          </p>
        </form>
      </div>
    </div>

    <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-gray-800">
      <div
        class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 gap-4"
      >
        <p class="text-xs sm:text-sm text-gray-400 text-center md:text-left">
          © {currentYear} Awesome Directories. Open source under
          <a
            href="https://github.com/awesome-directories/awesome-directories/blob/main/LICENSE"
            target="_blank"
            rel="noopener"
            class="text-gray-300 hover:text-white transition-colors underline"
          >
            Apache 2.0 License
          </a>
        </p>

        <div class="flex items-center space-x-6">
          <a
