---
var currentYear = new Date().getFullYear();
---

<footer class="app-footer">
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-10">
      <div>
        <h2 class="footer-heading">
          Awesome Directories
        </h2>
        <p class="footer-text mb-3 sm:mb-4 leading-relaxed">
          Hand-picked directories that actually drive traffic—filter by DR,
          export to CSV, and track submissions per project. Built by an indie
          hacker who got tired of garbage directory lists.
        </p>
        <p class="footer-text">
          Built by
          <a
            href="https://meysam.io"
            target="_blank"
            rel="noopener"
            class="footer-link-accent"
          >
            Meysam
          </a>
        </p>
      </div>

      <div>
        <h2 class="footer-heading">
          Links
        </h2>
        <ul class="space-y-2 sm:space-y-2.5">
          <li>
            <a href="/about" class="footer-link">
              About
            </a>
          </li>
          <li>
            <a href="/submit" class="footer-link">
              Submit Directory
            </a>
          </li>
          <li>
            <a href="/stats" class="footer-link">
              Public Stats
            </a>
          </li>
          <li>
            <a href="/terms" class="footer-link">
              Terms of Service
            </a>
          </li>
          <li>
            <a href="/privacy" class="footer-link">
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="https://github.com/awesome-directories/awesome-directories"
              target="_blank"
              rel="noopener"
              class="footer-link"
            >
              GitHub Repository
            </a>
          </li>
          <li>
            <a
              href="https://github.com/sponsors/meysam81"
              target="_blank"
              rel="noopener"
              class="footer-link"
            >
              <span aria-hidden="true">💝</span> GitHub Sponsors
            </a>
          </li>
        </ul>
      </div>

      <div class="sm:col-span-2 lg:col-span-1">
        <h2 class="footer-heading">
          Don't Miss the Next High-DR Directory We Add
        </h2>
        <p class="footer-text mb-3 leading-relaxed">
          We add new verified directories weekly. Be the first to know—plus get
          actionable launch strategies that actually work.
        </p>
        <form id="newsletter-form" class="space-y-3">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="Your email"
            class="newsletter-input"
          />

          <button
            id="newsletter-submit"
            type="submit"
            class="newsletter-button"
          >
            Join 100+ Founders
          </button>

          <p id="newsletter-success" class="newsletter-message success hidden"></p>
          <p id="newsletter-error" class="newsletter-message error hidden"></p>

          <p class="footer-fine-print">
            One email per week. Unsubscribe anytime. We hate spam too.
          </p>
        </form>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0 gap-4">
        <p class="footer-copyright">
          © {currentYear} Awesome Directories. Open source under
          <a
            href="https://github.com/awesome-directories/awesome-directories/blob/main/LICENSE"
            target="_blank"
            rel="noopener"
            class="footer-link-inline"
          >
            Apache 2.0 License
          </a>
        </p>

        <div class="flex items-center space-x-6">
          <a
            href="https://github.com/awesome-directories/awesome-directories"
            target="_blank"
            rel="noopener"
            class="footer-social-link"
            aria-label="Visit our GitHub repository"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

          <a
            href="https://x.com/meysamazing"
            target="_blank"
            rel="noopener"
            class="footer-social-link"
            aria-label="Follow us on X (formerly Twitter)"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .app-footer {
    background-color: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .footer-heading {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: white;
  }

  @media (min-width: 640px) {
    .footer-heading {
      font-size: 1.125rem;
      margin-bottom: 1rem;
    }
  }

  .footer-text {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-link {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--duration-fast) var(--ease-default);
    display: inline-block;
    padding: 0.25rem 0;
    text-decoration: none;
  }

  .footer-link:hover {
    color: white;
  }

  .footer-link-accent {
    color: var(--color-brand-accent);
    transition: color var(--duration-fast) var(--ease-default);
    text-decoration: underline;
  }

  .footer-link-accent:hover {
    color: white;
  }

  .footer-link-inline {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--duration-fast) var(--ease-default);
    text-decoration: underline;
  }

  .footer-link-inline:hover {
    color: white;
  }

  /* Newsletter Form */
  .newsletter-input {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    color: white;
    font-size: 0.875rem;
    min-height: 44px;
    transition: border-color var(--duration-fast) var(--ease-default),
                background-color var(--duration-fast) var(--ease-default);
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-brand-primary);
    background-color: rgba(255, 255, 255, 0.15);
  }

  .newsletter-button {
    width: 100%;
    min-height: 44px;
    padding: 0.75rem 1rem;
    background-color: var(--color-brand-primary);
    color: white;
    font-weight: 600;
    font-size: 0.875rem;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-default);
  }

  .newsletter-button:hover {
    background-color: var(--color-brand-primary-hover);
  }

  .newsletter-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-message {
    font-size: 0.875rem;
  }

  .newsletter-message.success {
    color: var(--color-success);
  }

  .newsletter-message.error {
    color: var(--color-error);
  }

  .footer-fine-print {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.625;
  }

  /* Footer Bottom */
  .footer-bottom {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      margin-top: 3rem;
      padding-top: 2rem;
    }
  }

  .footer-copyright {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  @media (min-width: 640px) {
    .footer-copyright {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .footer-copyright {
      text-align: left;
    }
  }

  .footer-social-link {
    color: rgba(255, 255, 255, 0.5);
    transition: color var(--duration-fast) var(--ease-default);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
  }

  .footer-social-link:hover {
    color: white;
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .hidden {
    display: none;
  }
</style>

<script>
  import { supabase } from "@/lib/supabase-client";

  var form = document.getElementById("newsletter-form") as HTMLFormElement;
  var emailInput = document.getElementById(
    "newsletter-email",
  ) as HTMLInputElement;
  var submitButton = document.getElementById(
    "newsletter-submit",
  ) as HTMLButtonElement;
  var successMessage = document.getElementById("newsletter-success");
  var errorMessage = document.getElementById("newsletter-error");

  form?.addEventListener("submit", async function handleSubmit(e) {
    e.preventDefault();

    var email = emailInput?.value;
    if (!email) return;

    if (submitButton) submitButton.disabled = true;
    if (submitButton) submitButton.textContent = "Subscribing...";
    successMessage?.classList.add("hidden");
    errorMessage?.classList.add("hidden");

    try {
      var { error: dbError } = await supabase
        .from("newsletter_signups")
        .insert({
          email,
          source: "footer",
        });

      if (dbError) {
        if (dbError.code === "23505") {
          if (successMessage) {
            successMessage.textContent = "You are already subscribed!";
            successMessage.classList.remove("hidden");
          }
          emailInput.value = "";
          return;
        } else {
          throw dbError;
        }
      }

      var mauticBaseUrl = import.meta.env.PUBLIC_MAUTIC_BASE_URL;
      var mauticFormId = import.meta.env.PUBLIC_MAUTIC_FORM_ID;

      if (mauticBaseUrl && mauticFormId) {
        var formData = new FormData();
        formData.append("mauticform[email]", email);
        formData.append("mauticform[formId]", mauticFormId);

        await fetch(`${mauticBaseUrl}/form/submit?formId=${mauticFormId}`, {
          method: "POST",
          body: formData,
          mode: "no-cors",
        });
      }

      if (successMessage) {
        successMessage.textContent = "Subscribed! Check your email.";
        successMessage.classList.remove("hidden");
      }
      emailInput.value = "";

      if (typeof window !== "undefined" && (window as any).pirsch) {
        (window as any).pirsch("Newsletter Signup", { source: "footer" });
      }
    } catch (error) {
      console.error("Newsletter signup error:", error);
      if (errorMessage) {
        errorMessage.textContent = "Failed to subscribe. Please try again.";
        errorMessage.classList.remove("hidden");
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
      if (submitButton) submitButton.textContent = "Join 100+ Founders";
    }
  });
</script>
