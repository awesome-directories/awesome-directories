---
var currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About Section -->
      <div>
        <h2 class="text-white font-bold text-lg mb-4">Awesome Directories</h2>
        <p class="text-sm text-gray-300 mb-4">
          Find the top 20 launch directories worth your time in under 3
          minutes—curated, verified, and updated weekly.
        </p>
        <p class="text-sm text-gray-300">
          Built by
          <a
            href="https://meysam.io"
            target="_blank"
            rel="noopener"
            class="text-blue-400 hover:text-blue-300 transition-colors underline"
          >
            Meysam
          </a>
        </p>
      </div>

      <!-- Links Section -->
      <div>
        <h2 class="text-white font-bold text-lg mb-4">Links</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/about"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              About
            </a>
          </li>
          <li>
            <a
              href="/submit"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              Submit Directory
            </a>
          </li>
          <li>
            <a
              href="/stats"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              Public Stats
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              Terms of Service
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="https://github.com/awesome-directories/awesome-directories"
              target="_blank"
              rel="noopener"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              GitHub Repository
            </a>
          </li>
          <li>
            <a
              href="https://github.com/sponsors/meysam81"
              target="_blank"
              rel="noopener"
              class="text-sm text-gray-300 hover:text-white transition-colors"
            >
              💝 GitHub Sponsors
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter Section -->
      <div>
        <h2 class="text-white font-bold text-lg mb-4">
          📬 Get launch strategies & new directories
        </h2>
        <form id="newsletter-form" class="space-y-3">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="Your email"
            class="w-full px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
          />

          <button
            id="newsletter-submit"
            type="submit"
            class="w-full btn-primary"
          >
            Subscribe
          </button>

          <p id="newsletter-success" class="text-sm text-success hidden"></p>
          <p id="newsletter-error" class="text-sm text-danger hidden"></p>

          <p class="text-xs text-gray-400">
            We respect your inbox. Unsubscribe anytime.
          </p>
        </form>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="mt-12 pt-8 border-t border-gray-800">
      <div
        class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
      >
        <p class="text-sm text-gray-400">
          © {currentYear} Awesome Directories. Open source under
          <a
            href="https://github.com/awesome-directories/awesome-directories/blob/main/LICENSE"
            target="_blank"
            rel="noopener"
            class="text-gray-300 hover:text-white transition-colors underline"
          >
            Apache 2.0 License
          </a>
        </p>

        <div class="flex items-center space-x-6">
          <a
            href="https://github.com/awesome-directories/awesome-directories"
            target="_blank"
            rel="noopener"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="Visit our GitHub repository"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
          </a>

          <a
            href="https://x.com/meysamazing"
            target="_blank"
            rel="noopener"
            class="text-gray-400 hover:text-white transition-colors"
            aria-label="Follow us on X (formerly Twitter)"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { supabase } from '@/lib/supabase-client';

  var form = document.getElementById('newsletter-form') as HTMLFormElement;
  var emailInput = document.getElementById(
    'newsletter-email'
  ) as HTMLInputElement;
  var submitButton = document.getElementById(
    'newsletter-submit'
  ) as HTMLButtonElement;
  var successMessage = document.getElementById('newsletter-success');
  var errorMessage = document.getElementById('newsletter-error');

  form?.addEventListener('submit', async function handleSubmit(e) {
    e.preventDefault();

    var email = emailInput?.value;
    if (!email) return;

    if (submitButton) submitButton.disabled = true;
    if (submitButton) submitButton.textContent = 'Subscribing...';
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');

    try {
      var { error: dbError } = await supabase
        .from('newsletter_signups')
        .insert({
          email,
          source: 'footer',
        });

      if (dbError) {
        if (dbError.code === '23505') {
          if (successMessage) {
            successMessage.textContent = 'You are already subscribed!';
            successMessage.classList.remove('hidden');
          }
          emailInput.value = '';
          return;
        } else {
          throw dbError;
        }
      }

      var mauticBaseUrl = import.meta.env.PUBLIC_MAUTIC_BASE_URL;
      var mauticFormId = import.meta.env.PUBLIC_MAUTIC_FORM_ID;

      if (mauticBaseUrl && mauticFormId) {
        var formData = new FormData();
        formData.append('mauticform[email]', email);
        formData.append('mauticform[formId]', mauticFormId);

        await fetch(`${mauticBaseUrl}/form/submit?formId=${mauticFormId}`, {
          method: 'POST',
          body: formData,
          mode: 'no-cors',
        });
      }

      if (successMessage) {
        successMessage.textContent = '✅ Subscribed! Check your email.';
        successMessage.classList.remove('hidden');
      }
      emailInput.value = '';

      if (typeof window !== 'undefined' && (window as any).pirsch) {
        (window as any).pirsch('Newsletter Signup', { source: 'footer' });
      }
    } catch (error) {
      console.error('Newsletter signup error:', error);
      if (errorMessage) {
        errorMessage.textContent = 'Failed to subscribe. Please try again.';
        errorMessage.classList.remove('hidden');
      }
    } finally {
      if (submitButton) submitButton.disabled = false;
      if (submitButton) submitButton.textContent = 'Subscribe';
    }
  });
</script>
