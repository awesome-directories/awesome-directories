---
import type { CollectionEntry } from "astro:content";
import { formatDate, calculateReadingTime, getPostSlug } from "@/utils/blog";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

if (posts.length === 0) {
  return null;
}
---

<section class="mt-12 border-t pt-12">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Related Posts</h2>

  <div class="grid md:grid-cols-3 gap-6">
    {
      posts.map(function mapPosts(post) {
        var readingTime = calculateReadingTime(post.body);
        var postSlug = getPostSlug(post);

        return (
          <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
            {post.data.coverImage && (
              <a href={`/blog/${postSlug}`} class="block">
                <img
                  src={post.data.coverImage}
                  alt={post.data.coverImageAlt || post.data.title}
                  class="w-full h-32 object-cover"
                  loading="lazy"
                />
              </a>
            )}

            <div class="p-4">
              <div class="flex items-center gap-2 text-xs text-gray-600 mb-2">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <span>•</span>
                <span>{readingTime} min read</span>
              </div>

              <a href={`/blog/${postSlug}`} class="block group">
                <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
              </a>

              <p class="text-gray-600 text-sm mb-3 line-clamp-2">
                {post.data.description}
              </p>

              <div class="flex flex-wrap gap-1">
                {post.data.tags.slice(0, 2).map(function mapTags(tag) {
                  return (
                    <span class="inline-block px-2 py-0.5 text-xs bg-blue-100 text-blue-800 rounded-full">
                      #{tag}
                    </span>
                  );
                })}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
