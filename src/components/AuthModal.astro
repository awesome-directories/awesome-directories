---
// Auth Modal Component - Handles Google and GitHub OAuth sign-in
---

<div
  id="auth-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  role="dialog"
  aria-labelledby="auth-modal-title"
  aria-modal="true"
>
  <!-- Backdrop -->
  <div
    id="auth-modal-backdrop"
    class="fixed inset-0 bg-gray-900 bg-opacity-75 transition-opacity"
  >
  </div>

  <!-- Modal Content -->
  <div
    class="relative bg-white rounded-lg shadow-xl max-w-md w-full p-6 transform transition-all"
  >
    <!-- Close Button -->
    <button
      id="auth-modal-close"
      class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors"
      aria-label="Close modal"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Content -->
    <div class="text-center">
      <div class="text-4xl mb-4">🚀</div>
      <h2
        id="auth-modal-title"
        class="text-2xl font-bold text-gray-900 mb-2"
      >
        Welcome to Awesome Directories
      </h2>
      <p class="text-gray-600 mb-6">
        Sign in to save favorites, upvote directories, and submit new listings
      </p>

      <!-- Auth Buttons -->
      <div class="space-y-3">
        <!-- Google Sign In -->
        <button
          id="google-sign-in"
          class="w-full flex items-center justify-center space-x-3 px-4 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <span class="font-medium text-gray-700" id="google-sign-in-text">
            Continue with Google
          </span>
        </button>

        <!-- GitHub Sign In -->
        <button
          id="github-sign-in"
          class="w-full flex items-center justify-center space-x-3 px-4 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
          <span class="font-medium" id="github-sign-in-text">
            Continue with GitHub
          </span>
        </button>

        <!-- Error Message -->
        <div
          id="auth-error"
          class="hidden mt-4 p-3 bg-red-50 border border-red-200 rounded-lg"
        >
          <p class="text-sm text-red-600" id="auth-error-message"></p>
        </div>
      </div>

      <!-- Continue without account -->
      <div class="mt-6 pt-6 border-t border-gray-200">
        <button
          id="auth-modal-skip"
          class="text-sm text-gray-600 hover:text-gray-900 transition-colors font-medium"
        >
          Continue without account
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { signInWithOAuth } from "@/lib/supabase-client";

  // Modal state
  let isLoading = false;
  let activeProvider: string | null = null;

  // Get DOM elements
  const modal = document.getElementById("auth-modal");
  const backdrop = document.getElementById("auth-modal-backdrop");
  const closeButton = document.getElementById("auth-modal-close");
  const skipButton = document.getElementById("auth-modal-skip");
  const googleButton = document.getElementById("google-sign-in");
  const githubButton = document.getElementById("github-sign-in");
  const errorDiv = document.getElementById("auth-error");
  const errorMessage = document.getElementById("auth-error-message");
  const googleText = document.getElementById("google-sign-in-text");
  const githubText = document.getElementById("github-sign-in-text");

  // Show modal function
  function showModal() {
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  // Hide modal function
  function hideModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
    resetModal();
  }

  // Reset modal state
  function resetModal() {
    isLoading = false;
    activeProvider = null;
    errorDiv?.classList.add("hidden");
    if (googleText) googleText.textContent = "Continue with Google";
    if (githubText) githubText.textContent = "Continue with GitHub";
    googleButton?.removeAttribute("disabled");
    githubButton?.removeAttribute("disabled");
  }

  // Show error
  function showError(message: string) {
    if (errorMessage) errorMessage.textContent = message;
    errorDiv?.classList.remove("hidden");
  }

  // Handle Google sign in
  async function handleGoogleSignIn() {
    if (isLoading) return;

    isLoading = true;
    activeProvider = "google";
    if (googleText) googleText.textContent = "Signing in...";
    googleButton?.setAttribute("disabled", "true");
    githubButton?.setAttribute("disabled", "true");
    errorDiv?.classList.add("hidden");

    try {
      await signInWithOAuth("google");
      // OAuth redirect will happen, no need to hide modal
    } catch (error) {
      console.error("Google sign in error:", error);
      showError("Failed to sign in with Google. Please try again.");
      resetModal();
    }
  }

  // Handle GitHub sign in
  async function handleGithubSignIn() {
    if (isLoading) return;

    isLoading = true;
    activeProvider = "github";
    if (githubText) githubText.textContent = "Signing in...";
    googleButton?.setAttribute("disabled", "true");
    githubButton?.setAttribute("disabled", "true");
    errorDiv?.classList.add("hidden");

    try {
      await signInWithOAuth("github");
      // OAuth redirect will happen, no need to hide modal
    } catch (error) {
      console.error("GitHub sign in error:", error);
      showError("Failed to sign in with GitHub. Please try again.");
      resetModal();
    }
  }

  // Event listeners
  closeButton?.addEventListener("click", hideModal);
  skipButton?.addEventListener("click", hideModal);
  backdrop?.addEventListener("click", hideModal);
  googleButton?.addEventListener("click", handleGoogleSignIn);
  githubButton?.addEventListener("click", handleGithubSignIn);

  // Listen for custom event to show modal
  window.addEventListener("show-auth-modal", showModal);

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      hideModal();
    }
  });
</script>
