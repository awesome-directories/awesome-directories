---
import Logo from "./Logo.astro";
import GithubStars from "./GithubStars.vue";
import ProductHuntBadge from "./ProductHuntBadge.vue";
import ThemeToggle from "./ThemeToggle.vue";
---

<header
  id="app-header"
  class="app-header sticky top-0 z-sticky"
>
  <div class="max-w-8xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-16">
      <a
        href="/"
        class="flex items-center hover:opacity-80 transition-opacity min-h-[48px] min-w-[48px] sm:min-h-[44px] sm:min-w-[44px] -ml-2 pl-2 touch-manipulation"
        aria-label="Awesome Directories home"
      >
        <Logo size="md" spacing="lg" />
      </a>

      <nav class="hidden md:flex items-center space-x-4 lg:space-x-6">
        <div class="min-w-[50px] flex items-center justify-center">
          <GithubStars client:load />
        </div>
        <div class="min-w-[50px] flex items-center justify-center">
          <ProductHuntBadge />
        </div>

        <a
          href="/blog"
          class="nav-link"
        >
          Blog
        </a>

        <a
          href="/submit"
          class="nav-link whitespace-nowrap"
        >
          Submit Directory
        </a>

        <a
          href="/about"
          class="nav-link"
        >
          About
        </a>

        <a
          href="/stats"
          class="nav-link"
        >
          Stats
        </a>

        <ThemeToggle client:load />

        <div id="user-menu-container" class="relative hidden">
          <button
            id="user-menu-button"
            class="user-menu-button"
            aria-label="User menu"
            aria-expanded="false"
          >
            <div
              id="user-avatar"
              class="w-9 h-9 rounded-full bg-brand-primary text-white flex items-center justify-center font-medium text-sm"
            >
            </div>
          </button>

          <div
            id="user-menu-dropdown"
            class="dropdown-menu hidden absolute right-0 mt-2 w-48"
          >
            <a
              href="/favorites"
              class="dropdown-item"
            >
              <span aria-hidden="true">❤️</span> My Favorites
            </a>
            <a
              href="/my-submissions"
              class="dropdown-item"
            >
              <span aria-hidden="true">📋</span> My Submissions
            </a>
            <a
              href="/submissions"
              class="dropdown-item"
            >
              <span aria-hidden="true">✅</span> My Projects
            </a>
            <button
              id="sign-out-button"
              class="dropdown-item w-full text-left"
            >
              <span aria-hidden="true">🚪</span> Sign Out
            </button>
          </div>
        </div>

        <button
          id="sign-in-button"
          class="btn-primary text-sm hidden min-h-[44px] px-4 touch-manipulation"
        >
          Sign In
        </button>
      </nav>

      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle client:load />
        <button
          id="mobile-menu-button"
          class="mobile-menu-button"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
        >
          <svg
            id="menu-icon-open"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div
      id="mobile-menu"
      class="mobile-menu hidden md:hidden"
    >
      <nav class="flex flex-col space-y-1">
        <div class="flex items-center justify-start gap-2 px-3 py-2 mb-1">
          <div class="min-w-[50px] flex items-center">
            <GithubStars client:load />
          </div>
          <ProductHuntBadge />
        </div>

        <a
          href="/blog"
          class="mobile-nav-link mobile-menu-link"
        >
          Blog
        </a>
        <a
          href="/submit"
          class="mobile-nav-link mobile-menu-link"
        >
          Submit Directory
        </a>
        <a
          href="/about"
          class="mobile-nav-link mobile-menu-link"
        >
          About
        </a>
        <a
          href="/stats"
          class="mobile-nav-link mobile-menu-link"
        >
          Stats
        </a>

        <div
          id="mobile-user-links"
          class="mobile-user-section hidden"
        >
          <a
            href="/favorites"
            class="mobile-nav-link mobile-menu-link"
          >
            <span aria-hidden="true">❤️</span> My Favorites
          </a>
          <a
            href="/my-submissions"
            class="mobile-nav-link mobile-menu-link"
          >
            <span aria-hidden="true">📋</span> My Submissions
          </a>
          <a
            href="/submissions"
            class="mobile-nav-link mobile-menu-link"
          >
            <span aria-hidden="true">✅</span> My Projects
          </a>
          <button
            id="mobile-sign-out-button"
            class="mobile-nav-link w-full text-left"
          >
            <span aria-hidden="true">🚪</span> Sign Out
          </button>
        </div>

        <button
          id="mobile-sign-in-button"
          class="btn-primary text-sm w-full hidden min-h-[48px] mt-2 touch-manipulation"
        >
          Sign In
        </button>
      </nav>
    </div>
  </div>
</header>

<style scoped>
  /* Header container */
  .app-header {
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border-primary);
    box-shadow: var(--shadow-sm);
  }

  /* Navigation links */
  .nav-link {
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.875rem;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
    transition: color var(--duration-fast) var(--ease-default);
  }

  @media (min-width: 1024px) {
    .nav-link {
      font-size: 1rem;
    }
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* User menu button */
  .user-menu-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem;
    border-radius: var(--radius-lg);
    transition: color var(--duration-fast) var(--ease-default),
                background-color var(--duration-fast) var(--ease-default);
    touch-action: manipulation;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .user-menu-button:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-tertiary);
  }

  /* Dropdown menu */
  .dropdown-menu {
    background-color: var(--color-bg-primary);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 0.25rem 0;
    border: 1px solid var(--color-border-primary);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    min-height: 48px;
    transition: background-color var(--duration-fast) var(--ease-default),
                color var(--duration-fast) var(--ease-default);
    touch-action: manipulation;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .dropdown-item {
      min-height: 44px;
    }
  }

  .dropdown-item:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  /* Mobile menu button */
  .mobile-menu-button {
    padding: 0.5rem;
    color: var(--color-text-secondary);
    min-height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    margin-right: -0.5rem;
    transition: color var(--duration-fast) var(--ease-default),
                background-color var(--duration-fast) var(--ease-default);
    touch-action: manipulation;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-menu-button:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-tertiary);
  }

  .mobile-menu-button:active {
    background-color: var(--color-border-primary);
  }

  /* Mobile menu */
  .mobile-menu {
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border-primary);
    transition: all 0.2s ease-out;
    animation: slideDown 0.2s ease-out;
  }

  /* Mobile navigation links */
  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    min-height: 48px;
    transition: color var(--duration-fast) var(--ease-default),
                background-color var(--duration-fast) var(--ease-default);
    touch-action: manipulation;
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
  }

  .mobile-nav-link:hover {
    color: var(--color-brand-primary);
    background-color: var(--color-bg-tertiary);
  }

  .mobile-nav-link:active {
    background-color: var(--color-border-primary);
  }

  /* Mobile user section */
  .mobile-user-section {
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border-primary);
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Touch manipulation utility */
  .touch-manipulation {
    touch-action: manipulation;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { $user } from "@/stores/auth";
  import { supabase, getUser, signOut } from "@/lib/supabase-client";

  async function initAuth() {
    try {
      var user = await getUser();
      $user.set(user);
      updateUI(user);
    } catch (error) {
      $user.set(null);
      updateUI(null);
    }
  }

  function updateUI(user) {
    var userMenuContainer = document.getElementById("user-menu-container");
    var signInButton = document.getElementById("sign-in-button");
    var mobileUserLinks = document.getElementById("mobile-user-links");
    var mobileSignInButton = document.getElementById("mobile-sign-in-button");
    var userAvatar = document.getElementById("user-avatar");

    if (user) {
      userMenuContainer?.classList.remove("hidden");
      signInButton?.classList.add("hidden");
      mobileUserLinks?.classList.remove("hidden");
      mobileSignInButton?.classList.add("hidden");

      var email = user.email || "";
      var initial = email.charAt(0).toUpperCase();
      if (userAvatar) {
        userAvatar.textContent = initial;
      }
    } else {
      userMenuContainer?.classList.add("hidden");
      signInButton?.classList.remove("hidden");
      mobileUserLinks?.classList.add("hidden");
      mobileSignInButton?.classList.remove("hidden");
    }
  }

  var userMenuButton = document.getElementById("user-menu-button");
  var userMenuDropdown = document.getElementById("user-menu-dropdown");

  userMenuButton?.addEventListener("click", function toggleUserMenu() {
    userMenuDropdown?.classList.toggle("hidden");
  });

  document.addEventListener("click", function closeUserMenuOutside(e) {
    var target = e.target;
    if (
      !userMenuButton?.contains(target) &&
      !userMenuDropdown?.contains(target)
    ) {
      userMenuDropdown?.classList.add("hidden");
    }
  });

  var mobileMenuButton = document.getElementById("mobile-menu-button");
  var mobileMenu = document.getElementById("mobile-menu");
  var menuIconOpen = document.getElementById("menu-icon-open");
  var menuIconClose = document.getElementById("menu-icon-close");

  mobileMenuButton?.addEventListener("click", function toggleMobileMenu() {
    var isHidden = mobileMenu?.classList.contains("hidden");

    mobileMenu?.classList.toggle("hidden");
    menuIconOpen?.classList.toggle("hidden");
    menuIconClose?.classList.toggle("hidden");

    mobileMenuButton?.setAttribute(
      "aria-expanded",
      isHidden ? "true" : "false",
    );
  });

  var mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");
  mobileMenuLinks.forEach(function addCloseMobileMenu(link) {
    link.addEventListener("click", function closeMobileMenu() {
      mobileMenu?.classList.add("hidden");
      menuIconOpen?.classList.remove("hidden");
      menuIconClose?.classList.add("hidden");
      mobileMenuButton?.setAttribute("aria-expanded", "false");
    });
  });

  var signInButton = document.getElementById("sign-in-button");
  var mobileSignInButton = document.getElementById("mobile-sign-in-button");

  signInButton?.addEventListener("click", function showAuthModalDesktop() {
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  mobileSignInButton?.addEventListener("click", function showAuthModalMobile() {
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    mobileMenuButton?.setAttribute("aria-expanded", "false");
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  var signOutButton = document.getElementById("sign-out-button");
  var mobileSignOutButton = document.getElementById("mobile-sign-out-button");

  async function handleSignOut() {
    await signOut();
    $user.set(null);
    updateUI(null);
    userMenuDropdown?.classList.add("hidden");
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    mobileMenuButton?.setAttribute("aria-expanded", "false");
    window.location.href = "/";
  }

  signOutButton?.addEventListener("click", handleSignOut);
  mobileSignOutButton?.addEventListener("click", handleSignOut);

  supabase.auth.onAuthStateChange(function handleAuthChange(event, session) {
    var user = session?.user || null;
    $user.set(user);
    updateUI(user);
  });

  initAuth();
</script>
