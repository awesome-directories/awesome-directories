---
import Logo from "./Logo.astro";
import GithubStars from "./GithubStars.vue";
---

<header
  id="app-header"
  class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm"
>
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
        <Logo size="md" spacing="lg" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-6">
        <GithubStars
          client:load
          class="mr-4"
        />

        <a
          href="/blog"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          Blog
        </a>

        <a
          href="/submit"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          Submit Directory
        </a>

        <a
          href="/about"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          About
        </a>

        <a
          href="/stats"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors"
        >
          Stats
        </a>

        <!-- User Menu -->
        <div id="user-menu-container" class="relative hidden">
          <button
            id="user-menu-button"
            class="flex items-center space-x-2 text-gray-700 hover:text-gray-900 transition-colors"
            aria-label="User menu"
            aria-expanded="false"
          >
            <div
              id="user-avatar"
              class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-medium"
            >
            </div>
          </button>

          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1 border border-gray-200"
          >
            <a
              href="/favorites"
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              ❤️ My Favorites
            </a>
            <a
              href="/submissions"
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              ✅ My Submissions
            </a>
            <button
              id="sign-out-button"
              class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            >
              🚪 Sign Out
            </button>
          </div>
        </div>

        <button id="sign-in-button" class="btn-primary text-sm hidden">
          Sign In
        </button>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-gray-600 hover:text-gray-900"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden py-4 border-t border-gray-200"
    >
      <nav class="flex flex-col space-y-3">
        <a
          href="/blog"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link"
        >
          Blog
        </a>
        <a
          href="/submit"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link"
        >
          Submit Directory
        </a>
        <a
          href="/about"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link"
        >
          About
        </a>
        <a
          href="/stats"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link"
        >
          Stats
        </a>

        <div
          id="mobile-user-links"
          class="hidden pt-3 border-t border-gray-200 space-y-3"
        >
          <a
            href="/favorites"
            class="block text-gray-700 hover:text-primary font-medium mobile-menu-link"
          >
            ❤️ My Favorites
          </a>
          <a
            href="/submissions"
            class="block text-gray-700 hover:text-primary font-medium mobile-menu-link"
          >
            ✅ My Submissions
          </a>
          <button
            id="mobile-sign-out-button"
            class="text-gray-700 hover:text-primary font-medium"
          >
            🚪 Sign Out
          </button>
        </div>

        <button
          id="mobile-sign-in-button"
          class="btn-primary text-sm w-full hidden"
        >
          Sign In
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  import { $user } from "@/stores/auth";
  import { supabase, getUser, signOut } from "@/lib/supabase-client";

  // Initialize auth state
  async function initAuth() {
    try {
      const user = await getUser();
      $user.set(user);
      updateUI(user);
    } catch (error) {
      console.error("Failed to initialize auth:", error);
    }
  }

  // Update UI based on auth state
  function updateUI(user: any) {
    const userMenuContainer = document.getElementById("user-menu-container");
    const signInButton = document.getElementById("sign-in-button");
    const mobileUserLinks = document.getElementById("mobile-user-links");
    const mobileSignInButton = document.getElementById("mobile-sign-in-button");
    const userAvatar = document.getElementById("user-avatar");

    if (user) {
      // Show user menu
      userMenuContainer?.classList.remove("hidden");
      signInButton?.classList.add("hidden");
      mobileUserLinks?.classList.remove("hidden");
      mobileSignInButton?.classList.add("hidden");

      // Set user initial
      const email = user.email || "";
      const initial = email.charAt(0).toUpperCase();
      if (userAvatar) {
        userAvatar.textContent = initial;
      }
    } else {
      // Show sign in button
      userMenuContainer?.classList.add("hidden");
      signInButton?.classList.remove("hidden");
      mobileUserLinks?.classList.add("hidden");
      mobileSignInButton?.classList.remove("hidden");
    }
  }

  // User menu toggle
  const userMenuButton = document.getElementById("user-menu-button");
  const userMenuDropdown = document.getElementById("user-menu-dropdown");

  userMenuButton?.addEventListener("click", () => {
    userMenuDropdown?.classList.toggle("hidden");
  });

  // Close user menu when clicking outside
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (
      !userMenuButton?.contains(target) &&
      !userMenuDropdown?.contains(target)
    ) {
      userMenuDropdown?.classList.add("hidden");
    }
  });

  // Mobile menu toggle
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  mobileMenuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    menuIconOpen?.classList.toggle("hidden");
    menuIconClose?.classList.toggle("hidden");
  });

  // Close mobile menu on link click
  const mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");
  mobileMenuLinks.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuIconOpen?.classList.remove("hidden");
      menuIconClose?.classList.add("hidden");
    });
  });

  // Sign in button
  const signInButton = document.getElementById("sign-in-button");
  const mobileSignInButton = document.getElementById("mobile-sign-in-button");

  signInButton?.addEventListener("click", () => {
    // Dispatch custom event to show auth modal
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  mobileSignInButton?.addEventListener("click", () => {
    // Close mobile menu
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");

    // Dispatch custom event to show auth modal
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  // Sign out buttons
  const signOutButton = document.getElementById("sign-out-button");
  const mobileSignOutButton = document.getElementById("mobile-sign-out-button");

  async function handleSignOut() {
    await signOut();
    $user.set(null);
    updateUI(null);
    userMenuDropdown?.classList.add("hidden");
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    window.location.href = "/";
  }

  signOutButton?.addEventListener("click", handleSignOut);
  mobileSignOutButton?.addEventListener("click", handleSignOut);

  // Listen for auth changes
  supabase.auth.onAuthStateChange((event, session) => {
    const user = session?.user || null;
    $user.set(user);
    updateUI(user);
  });

  // Initialize on load
  initAuth();
</script>
