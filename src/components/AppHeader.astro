---
import Logo from "./Logo.astro";
import GithubStars from "./GithubStars.vue";
import ProductHuntBadge from "./ProductHuntBadge.vue";
---

<header
  id="app-header"
  class="sticky top-0 z-50 bg-white border-b border-gray-200 shadow-sm"
>
  <div class="max-w-8xl mx-auto px-3 sm:px-4 md:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-16">
      <a
        href="/"
        class="flex items-center hover:opacity-80 transition-opacity min-h-[48px] min-w-[48px] sm:min-h-[44px] sm:min-w-[44px] -ml-2 pl-2 touch-manipulation"
        aria-label="Awesome Directories home"
      >
        <Logo size="md" spacing="lg" />
      </a>

      <nav class="hidden md:flex items-center space-x-4 lg:space-x-6">
        <div class="min-w-[50px] flex items-center justify-center">
          <GithubStars client:load />
        </div>
        <div class="min-w-[50px] flex items-center justify-center">
          <ProductHuntBadge />
        </div>

        <a
          href="/blog"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm lg:text-base min-h-[44px] flex items-center px-2"
        >
          Blog
        </a>

        <a
          href="/submit"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm lg:text-base whitespace-nowrap min-h-[44px] flex items-center px-2"
        >
          Submit Directory
        </a>

        <a
          href="/about"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm lg:text-base min-h-[44px] flex items-center px-2"
        >
          About
        </a>

        <a
          href="/stats"
          class="text-gray-600 hover:text-gray-900 font-medium transition-colors text-sm lg:text-base min-h-[44px] flex items-center px-2"
        >
          Stats
        </a>

        <div id="user-menu-container" class="relative hidden">
          <button
            id="user-menu-button"
            class="flex items-center space-x-2 text-gray-700 hover:text-gray-900 transition-colors min-h-[44px] min-w-[44px] px-2 rounded-lg hover:bg-gray-50 touch-manipulation"
            aria-label="User menu"
            aria-expanded="false"
          >
            <div
              id="user-avatar"
              class="w-9 h-9 rounded-full bg-primary text-white flex items-center justify-center font-medium text-sm"
            >
            </div>
          </button>

          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-1 border border-gray-200"
          >
            <a
              href="/favorites"
              class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-100 min-h-[48px] sm:min-h-[44px] flex items-center touch-manipulation"
            >
              ❤️ My Favorites
            </a>
            <a
              href="/submissions"
              class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-100 min-h-[48px] sm:min-h-[44px] flex items-center touch-manipulation"
            >
              ✅ My Submissions
            </a>
            <button
              id="sign-out-button"
              class="block w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-gray-100 min-h-[48px] sm:min-h-[44px] touch-manipulation"
            >
              🚪 Sign Out
            </button>
          </div>
        </div>

        <button
          id="sign-in-button"
          class="btn-primary text-sm hidden min-h-[44px] px-4 touch-manipulation"
        >
          Sign In
        </button>
      </nav>

      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-gray-600 hover:text-gray-900 min-h-[48px] min-w-[48px] flex items-center justify-center rounded-lg hover:bg-gray-50 -mr-2 touch-manipulation active:bg-gray-100 transition-colors"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden py-3 border-t border-gray-200 transition-all duration-200"
    >
      <nav class="flex flex-col space-y-1">
        <div class="flex items-center justify-start gap-2 px-3 py-2 mb-1">
          <div class="min-w-[50px] flex items-center">
            <GithubStars client:load />
          </div>
          <ProductHuntBadge />
        </div>

        <a
          href="/blog"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] flex items-center touch-manipulation"
        >
          Blog
        </a>
        <a
          href="/submit"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] flex items-center touch-manipulation"
        >
          Submit Directory
        </a>
        <a
          href="/about"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] flex items-center touch-manipulation"
        >
          About
        </a>
        <a
          href="/stats"
          class="text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] flex items-center touch-manipulation"
        >
          Stats
        </a>

        <div
          id="mobile-user-links"
          class="hidden pt-2 border-t border-gray-200 space-y-1 mt-2"
        >
          <a
            href="/favorites"
            class="block text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] touch-manipulation"
          >
            ❤️ My Favorites
          </a>
          <a
            href="/submissions"
            class="block text-gray-700 hover:text-primary font-medium mobile-menu-link px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] touch-manipulation"
          >
            ✅ My Submissions
          </a>
          <button
            id="mobile-sign-out-button"
            class="w-full text-left text-gray-700 hover:text-primary font-medium px-3 py-3 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition-colors min-h-[48px] touch-manipulation"
          >
            🚪 Sign Out
          </button>
        </div>

        <button
          id="mobile-sign-in-button"
          class="btn-primary text-sm w-full hidden min-h-[48px] mt-2 touch-manipulation"
        >
          Sign In
        </button>
      </nav>
    </div>
  </div>
</header>

<style>
  .touch-manipulation {
    touch-action: manipulation;
  }

  #mobile-menu {
    animation: slideDown 0.2s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import { $user } from "@/stores/auth";
  import { supabase, getUser, signOut } from "@/lib/supabase-client";

  async function initAuth() {
    try {
      var user = await getUser();
      $user.set(user);
      updateUI(user);
    } catch (error) {
      $user.set(null);
      updateUI(null);
    }
  }

  function updateUI(user) {
    var userMenuContainer = document.getElementById("user-menu-container");
    var signInButton = document.getElementById("sign-in-button");
    var mobileUserLinks = document.getElementById("mobile-user-links");
    var mobileSignInButton = document.getElementById("mobile-sign-in-button");
    var userAvatar = document.getElementById("user-avatar");

    if (user) {
      userMenuContainer?.classList.remove("hidden");
      signInButton?.classList.add("hidden");
      mobileUserLinks?.classList.remove("hidden");
      mobileSignInButton?.classList.add("hidden");

      var email = user.email || "";
      var initial = email.charAt(0).toUpperCase();
      if (userAvatar) {
        userAvatar.textContent = initial;
      }
    } else {
      userMenuContainer?.classList.add("hidden");
      signInButton?.classList.remove("hidden");
      mobileUserLinks?.classList.add("hidden");
      mobileSignInButton?.classList.remove("hidden");
    }
  }

  var userMenuButton = document.getElementById("user-menu-button");
  var userMenuDropdown = document.getElementById("user-menu-dropdown");

  userMenuButton?.addEventListener("click", function toggleUserMenu() {
    userMenuDropdown?.classList.toggle("hidden");
  });

  document.addEventListener("click", function closeUserMenuOutside(e) {
    var target = e.target;
    if (
      !userMenuButton?.contains(target) &&
      !userMenuDropdown?.contains(target)
    ) {
      userMenuDropdown?.classList.add("hidden");
    }
  });

  var mobileMenuButton = document.getElementById("mobile-menu-button");
  var mobileMenu = document.getElementById("mobile-menu");
  var menuIconOpen = document.getElementById("menu-icon-open");
  var menuIconClose = document.getElementById("menu-icon-close");

  mobileMenuButton?.addEventListener("click", function toggleMobileMenu() {
    var isHidden = mobileMenu?.classList.contains("hidden");

    mobileMenu?.classList.toggle("hidden");
    menuIconOpen?.classList.toggle("hidden");
    menuIconClose?.classList.toggle("hidden");

    mobileMenuButton?.setAttribute("aria-expanded", isHidden ? "true" : "false");
  });

  var mobileMenuLinks = document.querySelectorAll(".mobile-menu-link");
  mobileMenuLinks.forEach(function addCloseMobileMenu(link) {
    link.addEventListener("click", function closeMobileMenu() {
      mobileMenu?.classList.add("hidden");
      menuIconOpen?.classList.remove("hidden");
      menuIconClose?.classList.add("hidden");
      mobileMenuButton?.setAttribute("aria-expanded", "false");
    });
  });

  var signInButton = document.getElementById("sign-in-button");
  var mobileSignInButton = document.getElementById("mobile-sign-in-button");

  signInButton?.addEventListener("click", function showAuthModalDesktop() {
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  mobileSignInButton?.addEventListener("click", function showAuthModalMobile() {
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    mobileMenuButton?.setAttribute("aria-expanded", "false");
    window.dispatchEvent(new CustomEvent("show-auth-modal"));
  });

  var signOutButton = document.getElementById("sign-out-button");
  var mobileSignOutButton = document.getElementById("mobile-sign-out-button");

  async function handleSignOut() {
    await signOut();
    $user.set(null);
    updateUI(null);
    userMenuDropdown?.classList.add("hidden");
    mobileMenu?.classList.add("hidden");
    menuIconOpen?.classList.remove("hidden");
    menuIconClose?.classList.add("hidden");
    mobileMenuButton?.setAttribute("aria-expanded", "false");
    window.location.href = "/";
  }

  signOutButton?.addEventListener("click", handleSignOut);
  mobileSignOutButton?.addEventListener("click", handleSignOut);

  supabase.auth.onAuthStateChange(function handleAuthChange(event, session) {
    var user = session?.user || null;
    $user.set(user);
    updateUI(user);
  });

  initAuth();
</script>
